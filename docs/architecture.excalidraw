2060, "y": 2920, "width": 50, "height": 18, "text": "Denver", "fontSize": 14, "fontFamily": 5}, {"type": "rectangle", "id": "rectangle_306", "x": 1780, "y": 3280, "width": 400, "height": 110, "strokeWidth": 1, "strokeColor": "#e03131", "backgroundColor": "#ffc9c9", "strokeStyle": "dashed"}, {"type": "text", "id": "text_307", "x": 1795, "y": 3292, "width": 342, "height": 54, "text": "heatmap cells along the corridor\n(colour = risk at slider hour)\nrecommended route solid green, others dashed", "fontSize": 14, "fontFamily": 5, "strokeColor": "#e03131"}, {"type": "text", "id": "text_308", "x": 900, "y": 3390, "width": 442, "height": 18, "text": "checkpoint dots coloured by risk; click for weather + ETA", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "rectangle", "id": "rectangle_309", "x": 600, "y": 3435, "width": 1610, "height": 105, "strokeWidth": 1, "strokeColor": "#495057", "backgroundColor": "#ffffff", "roundness": {"type": 3}}, {"type": "text", "id": "text_310", "x": 620, "y": 3445, "width": 258, "height": 18, "text": "\u2611 Corridor heatmap    \u2610 Trip only", "fontSize": 14, "fontFamily": 5}, {"type": "rectangle", "id": "rectangle_311", "x": 620, "y": 3475, "width": 38, "height": 32, "strokeWidth": 1, "strokeColor": "#1e1e1e", "roundness": {"type": 3}}, {"type": "text", "id": "text_312", "x": 634, "y": 3482, "width": 11, "height": 16, "text": "\u23ee", "fontSize": 13, "fontFamily": 5}, {"type": "rectangle", "id": "rectangle_313", "x": 666, "y": 3475, "width": 38, "height": 32, "strokeWidth": 2, "strokeColor": "#1e1e1e", "roundness": {"type": 3}}, {"type": "text", "id": "text_314", "x": 680, "y": 3482, "width": 11, "height": 16, "text": "\u25b6", "fontSize": 13, "fontFamily": 5}, {"type": "rectangle", "id": "rectangle_315", "x": 712, "y": 3475, "width": 38, "height": 32, "strokeWidth": 1, "strokeColor": "#1e1e1e", "roundness": {"type": 3}}, {"type": "text", "id": "text_316", "x": 726, "y": 3482, "width": 11, "height": 16, "text": "\u23ed", "fontSize": 13, "fontFamily": 5}, {"type": "line", "id": "line_317", "x": 780, "y": 3491, "width": 1, "height": 1, "points": [[0, 0], [1400, 0]], "strokeWidth": 3, "strokeColor": "#495057"}, {"type": "ellipse", "id": "ellipse_318", "x": 1180, "y": 3480, "width": 22, "height": 22, "strokeWidth": 2, "strokeColor": "#1971c2", "backgroundColor": "#1971c2"}, {"type": "text", "id": "text_319", "x": 780, "y": 3509, "width": 27, "height": 18, "text": "0 h", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_320", "x": 2150, "y": 3509, "width": 34, "height": 18, "text": "48 h", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_321", "x": 1140, "y": 3509, "width": 173, "height": 18, "text": "+5h 30m \u00b7 15-min steps", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1971c2"}, {"type": "text", "id": "text_322", "x": 1460, "y": 3509, "width": 481, "height": 18, "text": "\u23ee \u23ed jump between checkpoints \u00b7 \u25b6 drives the truck stop by stop", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_323", "x": 0, "y": 3630, "width": 281, "height": 46, "text": "LIMITS TO KNOW", "fontSize": 36, "fontFamily": 5}, {"type": "text", "id": "text_324", "x": 0, "y": 3678, "width": 667, "height": 23, "text": "what the free public providers limit, and what the model leaves out", "fontSize": 18, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_325", "x": 0, "y": 3740, "width": 602, "height": 132, "text": "rate limits\n\u00b7 Open-Meteo free tier: < 600 / min, 5,000 / h, 10,000 / day,\n  non-commercial (a trip uses \u2264 400 lookups; repeats are cached)\n\u00b7 OSRM + Photon are public demo servers\n\u00b7 our API: plan + heatmap 20/min, geocode 60/min,\n  one counter per IP and endpoint, in memory per worker", "fontSize": 17, "fontFamily": 5}, {"type": "text", "id": "text_326", "x": 760, "y": 3740, "width": 555, "height": 110, "text": "model\n\u00b7 OSRM car profile: no truck height / weight / hazmat roads\n\u00b7 ETA = non-stop driving: no rest, fuel, traffic\n\u00b7 weather point can move up to half a grid cell\n\u00b7 gusts shown, not scored; no ice, fog, temperature", "fontSize": 17, "fontFamily": 5}], "appState": {"viewBackgroundColor": "#ffffff", "gridSize": 20}, "files": {"file_react_orig": {"mimeType": "image/svg+xml", "id": "file_react_orig", "created": 1, "dataURL": "data:image/svg+xml;base64,"}, "file_docker_orig": {"mimeType": "image/svg+xml", "id": "file_docker_orig", "created": 1, "dataURL": "data:image/svg+xml;base64,"}, "file_openstreetmap_orig": {"mimeType": "image/svg+xml", "id": "file_openstreetmap_orig", "created": 1, "dataURL": "data:image/svg+xml;base64,"}}}