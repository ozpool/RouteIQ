eColor": "#000000", "backgroundColor": "#eeeeee"}, {"type": "text", "id": "text_34", "x": 732, "y": 558, "width": 92, "height": 20, "text": "WhiteNoise", "fontSize": 16, "fontFamily": 1}, {"type": "text", "id": "text_35", "x": 732, "y": 590, "width": 197, "height": 33, "text": "serves / and /app/ + assets\nsame origin, no CORS", "fontSize": 13, "fontFamily": 1, "strokeColor": "#495057"}, {"type": "rectangle", "id": "rectangle_36", "x": 1040, "y": 370, "width": 280, "height": 90, "strokeWidth": 1, "strokeColor": "#000000", "backgroundColor": "#eeeeee"}, {"type": "text", "id": "text_37", "x": 1052, "y": 378, "width": 74, "height": 20, "text": "services", "fontSize": 16, "fontFamily": 1}, {"type": "text", "id": "text_38", "x": 1052, "y": 410, "width": 189, "height": 33, "text": "RouteOptions \u00b7 TripPlanner\nCorridorHeatmap", "fontSize": 13, "fontFamily": 1, "strokeColor": "#495057"}, {"type": "rectangle", "id": "rectangle_39", "x": 1040, "y": 495, "width": 280, "height": 90, "strokeWidth": 1, "strokeColor": "#000000", "backgroundColor": "#eeeeee"}, {"type": "text", "id": "text_40", "x": 1052, "y": 503, "width": 180, "height": 20, "text": "domain \u00b7 pure Python", "fontSize": 16, "fontFamily": 1}, {"type": "text", "id": "text_41", "x": 1052, "y": 535, "width": 175, "height": 33, "text": "risk \u00b7 eta \u00b7 checkpoints\nscoring \u00b7 recommendation", "fontSize": 13, "fontFamily": 1, "strokeColor": "#495057"}, {"type": "rectangle", "id": "rectangle_42", "x": 1040, "y": 620, "width": 280, "height": 90, "strokeWidth": 1, "strokeColor": "#000000", "backgroundColor": "#eeeeee"}, {"type": "text", "id": "text_43", "x": 1052, "y": 628, "width": 188, "height": 20, "text": "adapters behind ports", "fontSize": 16, "fontFamily": 1}, {"type": "text", "id": "text_44", "x": 1052, "y": 660, "width": 239, "height": 33, "text": "OSRM \u00b7 Open-Meteo \u00b7 Photon\n+ weather cache \u00b7 provider status", "fontSize": 13, "fontFamily": 1, "strokeColor": "#495057"}, {"type": "d