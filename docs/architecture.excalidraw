ight": 19, "text": "ETA + risk per stop", "fontSize": 15, "fontFamily": 5}, {"type": "text", "id": "text_48", "x": 110, "y": 754, "width": 61, "height": 19, "text": "TripMap", "fontSize": 15, "fontFamily": 5}, {"type": "text", "id": "text_49", "x": 260, "y": 754, "width": 251, "height": 19, "text": "MapLibre: routes, dots, popups", "fontSize": 15, "fontFamily": 5}, {"type": "text", "id": "text_50", "x": 110, "y": 778, "width": 119, "height": 19, "text": "HeatmapControl", "fontSize": 15, "fontFamily": 5}, {"type": "text", "id": "text_51", "x": 260, "y": 778, "width": 169, "height": 19, "text": "0\u201348 h slider, \u23ee \u25b6 \u23ed", "fontSize": 15, "fontFamily": 5}, {"type": "text", "id": "text_52", "x": 110, "y": 812, "width": 119, "height": 19, "text": "TanStack Query", "fontSize": 15, "fontFamily": 5}, {"type": "text", "id": "text_53", "x": 260, "y": 812, "width": 243, "height": 19, "text": "calls the API, caches results", "fontSize": 15, "fontFamily": 5}, {"type": "text", "id": "text_54", "x": 110, "y": 880, "width": 327, "height": 72, "text": "POST /api/trips/plan\n{ origin:{lat,lon,label}, destination:{\u2026},\n  departure_time, load_weight_lb: 42000,\n  checkpoint_interval_mi: 25 }", "fontSize": 14, "fontFamily": 5}, {"type": "rectangle", "id": "rectangle_55", "x": 620, "y": 540, "width": 1100, "height": 600, "strokeWidth": 2, "strokeColor": "#1e1e1e", "strokeStyle": "dotted", "roundness": {"type": 3}}, {"type": "text", "id": "text_56", "x": 1480, "y": 552, "width": 224, "height": 26, "text": "one Docker container", "fontSize": 20, "fontFamily": 5}, {"type": "image", "id": "image_57", "x": 640, "y": 554, "width": 30, "height": 30.0, "fileId": "file_docker_orig", "status": "saved", "scale": [1, 1], "strokeColor": "transparent", "backgroundColor": "transparent"}, {"type": "arrow", "id": "arrow_58", "x": 565, "y": 625, "width": 100, "height": 0, "points": [[0, 0], [100, 0]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "text", "id": "text_59", "x": 5