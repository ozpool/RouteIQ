": 5}, {"type": "rectangle", "id": "rectangle_93", "x": 1800, "y": 700, "width": 420, "height": 130, "strokeWidth": 2, "strokeColor": "#1e1e1e", "backgroundColor": "#ffffff", "roundness": {"type": 3}}, {"type": "text", "id": "text_94", "x": 1820, "y": 714, "width": 114, "height": 26, "text": "Open-Meteo", "fontSize": 20, "fontFamily": 5}, {"type": "text", "id": "text_95", "x": 1820, "y": 754, "width": 268, "height": 41, "text": "hourly wind, rain, snow\n600/min \u00b7 5,000/h \u00b7 10,000/day", "fontSize": 16, "fontFamily": 5}, {"type": "rectangle", "id": "rectangle_96", "x": 1800, "y": 860, "width": 420, "height": 130, "strokeWidth": 2, "strokeColor": "#1e1e1e", "backgroundColor": "#ffffff", "roundness": {"type": 3}}, {"type": "image", "id": "image_97", "x": 1818, "y": 873, "width": 28, "height": 28.0, "fileId": "file_openstreetmap_orig", "status": "saved", "scale": [1, 1], "strokeColor": "transparent", "backgroundColor": "transparent"}, {"type": "text", "id": "text_98", "x": 1856, "y": 874, "width": 70, "height": 26, "text": "Photon", "fontSize": 20, "fontFamily": 5}, {"type": "text", "id": "text_99", "x": 1820, "y": 914, "width": 180, "height": 41, "text": "address autocomplete\nphoton.komoot.io", "fontSize": 16, "fontFamily": 5}, {"type": "rectangle", "id": "rectangle_100", "x": 1800, "y": 1020, "width": 420, "height": 110, "strokeWidth": 2, "strokeColor": "#1e1e1e", "backgroundColor": "#ffffff", "roundness": {"type": 3}}, {"type": "text", "id": "text_101", "x": 1820, "y": 1034, "width": 125, "height": 26, "text": "CARTO tiles", "fontSize": 20, "fontFamily": 5}, {"type": "text", "id": "text_102", "x": 1820, "y": 1074, "width": 206, "height": 41, "text": "map background, loaded\nstraight by the browser", "fontSize": 16, "fontFamily": 5}, {"type": "line", "id": "line_103", "x": 1315, "y": 995, "width": 1, "height": 1, "points": [[0, 0], [445, 0]], "strokeWidth": 2}, {"type": "line", "id": "line_104", "x": 1760, "y": 605, "width": 1, "height": 1, "points": [[0, 0], [0, 390]], "strokeWidth": 2}, {"type": "arrow", "id": "arrow_105", "x": 1760, "y": 605, "width": 35, "height": 0, "points": [[0, 0], [35, 0]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "arrow", "id": "arrow_106", "x": 1760, "y": 765, "width": 35, "height": 0, "points": [[0, 0], [35, 0]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "arrow", "id": "arrow_107", "x": 1760, "y": 925, "width": 35, "height": 0, "points": [[0, 0], [35, 0]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "arrow", "id": "arrow_108", "x": 300, "y": 1005, "width": 1710, "height": 175, "points": [[0, 0], [0, 175], [1710, 175], [1710, 130]], "endArrowhead": "arrow", "strokeWidth": 2, "strokeStyle": "dashed"}, {"type": "text", "id": "text_109", "x": 320, "y": 1188, "width": 288, "height": 18, "text": "map tiles go browser \u2192 CARTO directly", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_110", "x": 900, "y": 1188, "width": 1112, "height": 18, "text": "monitors \u2192 /api/health: UptimeRobot, platform health check, Docker HEALTHCHECK (30 s) \u00b7 always 200, \"degraded\" in the body when a provider fails", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_111", "x": 0, "y": 1300, "width": 439, "height": 46, "text": "ONE TRIP, STEP BY STEP", "fontSize": 36, "fontFamily": 5}, {"type": "text", "id": "text_112", "x": 0, "y": 1348, "width": 994, "height": 23, "text": "what POST /api/trips/plan does inside the server \u2014 every number below is a real constant in the code", "fontSize": 18, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "rectangle", "id": "rectangle_113", "x": 0, "y": 1410, "width": 330, "height": 190, "strokeWidth": 1, "strokeColor": "#000000", "backgroundColor": "#eeeeee"}, {"type": "text", "id": "text_114", "x": 12, "y": 1418, "width": 118, "height": 20, "text": "route_options", "fontSize": 16, "fontFamily": 1}, {"type": "text", "id": "text_115", "x": 12, "y": 1450, "width": 232, "height": 84, "text": "OSRM alternatives, then\nvia-point detours (\u00b115%, \u00b130%)\nuntil 3 distinct routes\n\u00b7 overlap \u2265 80% = duplicate\n\u00b7 > 1.75\u00d7 fastest time = dropped", "fontSize": 13, "fontFamily": 1, "strokeColor": "#495057"}, {"type": "rectangle", "id": "rectangle_116", "x": 375, "y": 1410, "width": 330, "height": 190, "strokeWidth": 1, "strokeColor": "#000000", "backgroundColor": "#eeeeee"}, {"type": "text", "id": "text_117", "x": 387, "y": 1418, "width": 153, "height": 20, "text": "checkpoints + eta", "fontSize": 16, "fontFamily": 1}, {"type": "text", "id": "text_118", "x": 387, "y": 1450, "width": 225, "height": 84, "text": "a stop at mile 0, every\n10 / 25 / 50 mi, + destination;\nETA from OSRM segment\ntimes, speed capped\nat 65 mph (truck)", "fontSize": 13, "fontFamily": 1, "strokeColor": "#495057"}, {"type": "arrow", "id": "arrow_119", "x": 330, "y": 1505, "width": 45, "height": 0, "points": [[0, 0], [45, 0]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "rectangle", "id": "rectangle_120", "x": 750, "y": 1410, "width": 330, "height": 190, "strokeWidth": 1, "strokeColor": "#000000", "backgroundColor": "#eeeeee"}, {"type": "text", "id": "text_121", "x": 762, "y": 1418, "width": 65, "height": 20, "text": "weather", "fontSize": 16, "fontFamily": 1}, {"type": "text", "id": "text_122", "x": 762, "y": 1450, "width": 175, "height": 84, "text": "stops snapped to a grid\n(0.2\u00b0 \u2026 1.5\u00b0), \u2264 250\nlookups per trip, cached\nper day; each stop reads\nthe hour of its own ETA", "fontSize": 13, "fontFamily": 1, "strokeColor": "#495057"}, {"type": "arrow", "id": "arrow_123", "x": 705, "y": 1505, "width": 45, "height": 0, "points": [[0, 0], [45, 0]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "rectangle", "id": "rectangle_124", "x": 1125, "y": 1410, "width": 330, "height": 190, "strokeWidth": 2, "strokeColor": "#1971c2", "backgroundColor": "#eeeeee"}, {"type": "text", "id": "text_125", "x": 1137, "y": 1418, "width": 100, "height": 20, "text": "risk.assess", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1971c2"}, {"type": "text", "id": "text_126", "x": 1137, "y": 1450, "width": 175, "height": 67, "text": "wind, rain, snow \u2192 level\nfrom the brief's table,\nthen load rules; stop\nlevel = worst of three", "fontSize": 13, "fontFamily": 1, "strokeColor": "#495057"}, {"type": "arrow", "id": "arrow_127", "x": 1080, "y": 1505, "width": 45, "height": 0, "points": [[0, 0], [45, 0]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "rectangle", "id": "rectangle_128", "x": 1500, "y": 1410, "width": 330, "height": 190, "strokeWidth": 1, "strokeColor": "#000000", "backgroundColor": "#eeeeee"}, {"type": "text", "id": "text_129", "x": 1512, "y": 1418, "width": 65, "height": 20, "text": "scoring", "fontSize": 16, "fontFamily": 1}, {"type": "text", "id": "text_130", "x": 1512, "y": 1450, "width": 189, "height": 67, "text": "each stop owns the road\nhalfway to its neighbours;\nmiles per level +\nrisk-miles (mi \u00d7 level)", "fontSize": 13, "fontFamily": 1, "strokeColor": "#495057"}, {"type": "arrow", "id": "arrow_131", "x": 1455, "y": 1505, "width": 45, "height": 0, "points": [[0, 0], [45, 0]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "rectangle", "id": "rectangle_132", "x": 1875, "y": 1410, "width": 330, "height": 190, "strokeWidth": 1, "strokeColor": "#000000", "backgroundColor": "#eeeeee"}, {"type": "text", "id": "text_133", "x": 1887, "y": 1418, "width": 127, "height": 20, "text": "recommendation", "fontSize": 16, "fontFamily": 1}, {"type": "text", "id": "text_134", "x": 1887, "y": 1450, "width": 175, "height": 67, "text": "rank routes, write the\nreason line and warnings\n(e.g. Severe miles left\non the best route)", "fontSize": 13, "fontFamily": 1, "strokeColor": "#495057"}, {"type": "arrow", "id": "arrow_135", "x": 1830, "y": 1505, "width": 45, "height": 0, "points": [[0, 0], [45, 0]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "text", "id": "text_136", "x": 0, "y": 1640, "width": 713, "height": 78, "text": "reply: { routes:[{ id, label, summary, distance_mi, duration_s, arrival,\n           checkpoints:[{ mile, eta, weather, risk:{ level, reasons, load_raised } }],\n           segments, risk:{ miles_by_level, exposure, average, max_level } }],\n         recommendation:{ route_id, ranking, reason, warnings }, notes }", "fontSize": 15, "fontFamily": 5}, {"type": "rectangle", "id": "rectangle_137", "x": 1125, "y": 1640, "width": 500, "height": 130, "strokeWidth": 1, "strokeColor": "#000000", "backgroundColor": "#eeeeee", "strokeStyle": "dashed"}, {"type": "text", "id": "text_138", "x": 1137, "y": 1648, "width": 206, "height": 20, "text": "POST /api/trips/heatmap", "fontSize": 16, "fontFamily": 1}, {"type": "text", "id": "text_139", "x": 1137, "y": 1680, "width": 318, "height": 50, "text": "separate call after the plan: corridor 25 mi\naround the routes, \u2264 150 grid cells,\nrisk for each of 49 hours (h0 \u2026 h48)", "fontSize": 13, "fontFamily": 1, "strokeColor": "#495057"}, {"type": "arrow", "id": "arrow_140", "x": 870, "y": 1705, "width": 250, "height": 0, "points": [[0, 0], [250, 0]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "text", "id": "text_141", "x": 900, "y": 1675, "width": 134, "height": 18, "text": "browser asks next", "fontSize": 14, "fontFamily": 5}, {"type": "text", "id": "text_142", "x": 0, "y": 1860, "width": 439, "height": 46, "text": "RISK AT ONE CHECKPOINT", "fontSize": 36, "fontFamily": 5}, {"type": "text", "id": "text_143", "x": 0, "y": 1908, "width": 756, "height": 23, "text": "the table gives a level per condition; the load rules can only make it worse", "fontSize": 18, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "rectangle", "id": "rectangle_144", "x": 0, "y": 1970, "width": 730, "height": 154, "strokeWidth": 1, "strokeColor": "#1e1e1e", "backgroundColor": "#ffffff"}, {"type": "line", "id": "line_145", "x": 0, "y": 2010, "width": 730, "height": 0, "strokeWidth": 1, "points": [[0, 0], [730, 0]]}, {"type": "text", "id": "text_146", "x": 10, "y": 1976, "width": 4, "height": 18, "text": "", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_147", "x": 10, "y": 2016, "width": 74, "height": 20, "text": "Wind mph", "fontSize": 16, "fontFamily": 5}, {"type": "text", "id": "text_148", "x": 10, "y": 2052, "width": 92, "height": 20, "text": "Rain in/hr", "fontSize": 16, "fontFamily": 5}, {"type": "text", "id": "text_149", "x": 10, "y": 2088, "width": 92, "height": 20, "text": "Snow in/hr", "fontSize": 16, "fontFamily": 5}, {"type": "line", "id": "line_150", "x": 120, "y": 1970, "width": 0, "height": 154, "strokeWidth": 1, "points": [[0, 0], [0, 154]]}, {"type": "text", "id": "text_151", "x": 130, "y": 1976, "width": 27, "height": 18, "text": "Low", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_152", "x": 130, "y": 2016, "width": 39, "height": 20, "text": "< 25", "fontSize": 16, "fontFamily": 5}, {"type": "text", "id": "text_153", "x": 130, "y": 2052, "width": 56, "height": 20, "text": "< 0.10", "fontSize": 16, "fontFamily": 5}, {"type": "text", "id": "text_154", "x": 130, "y": 2088, "width": 48, "height": 20, "text": "< 0.5", "fontSize": 16, "fontFamily": 5}, {"type": "line", "id": "line_155", "x": 210, "y": 1970, "width": 0, "height": 154, "strokeWidth": 1, "points": [[0, 0], [0, 154]]}, {"type": "text", "id": "text_156", "x": 220, "y": 1976, "width": 65, "height": 18, "text": "Moderate", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_157", "x": 220, "y": 2016, "width": 83, "height": 20, "text": "25 \u2013 < 35", "fontSize": 16, "fontFamily": 5}, {"type": "text", "id": "text_158", "x": 220, "y": 2052, "width": 118, "height": 20, "text": "0.10 \u2013 < 0.25", "fontSize": 16, "fontFamily": 5}, {"type": "text", "id": "text_159", "x": 220, "y": 2088, "width": 100, "height": 20, "text": "0.5 \u2013 < 1.0", "fontSize": 16, "fontFamily": 5}, {"type": "line", "id": "line_160", "x": 350, "y": 1970, "width": 0, "height": 154, "strokeWidth": 1, "points": [[0, 0], [0, 154]]}, {"type": "text", "id": "text_161", "x": 360, "y": 1976, "width": 34, "height": 18, "text": "High", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_162", "x": 360, "y": 2016, "width": 83, "height": 20, "text": "35 \u2013 < 45", "fontSize": 16, "fontFamily": 5}, {"type": "text", "id": "text_163", "x": 360, "y": 2052, "width": 118, "height": 20, "text": "0.25 \u2013 < 0.50", "fontSize": 16, "fontFamily": 5}, {"type": "text", "id": "text_164", "x": 360, "y": 2088, "width": 100, "height": 20, "text": "1.0 \u2013 < 2.0", "fontSize": 16, "fontFamily": 5}, {"type": "line", "id": "line_165", "x": 490, "y": 1970, "width": 0, "height": 154, "strokeWidth": 1, "points": [[0, 0], [0, 154]]}, {"type": "text", "id": "text_166", "x": 500, "y": 1976, "width": 50, "height": 18, "text": "Severe", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_167", "x": 500, "y": 2016, "width": 83, "height": 20, "text": "45 \u2013 < 55", "fontSize": 16, "fontFamily": 5}, {"type": "text", "id": "text_168", "x": 500, "y": 2052, "width": 100, "height": 20, "text": "0.50 \u2013 1.00", "fontSize": 16, "fontFamily": 5}, {"type": "text", "id": "text_169", "x": 500, "y": 2088, "width": 83, "height": 20, "text": "2.0 \u2013 3.0", "fontSize": 16, "fontFamily": 5}, {"type": "line", "id": "line_170", "x": 620, "y": 1970, "width": 0, "height": 154, "strokeWidth": 1, "points": [[0, 0], [0, 154]]}, {"type": "text", "id": "text_171", "x": 630, "y": 1976, "width": 73, "height": 18, "text": "No Travel", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_172", "x": 630, "y": 2016, "width": 39, "height": 20, "text": "\u2265 55", "fontSize": 16, "fontFamily": 5}, {"type": "text", "id": "text_173", "x": 630, "y": 2052, "width": 56, "height": 20, "text": "> 1.00", "fontSize": 16, "fontFamily": 5}, {"type": "text", "id": "text_174", "x": 630, "y": 2088, "width": 48, "height": 20, "text": "> 3.0", "fontSize": 16, "fontFamily": 5}, {"type": "text", "id": "text_175", "x": 0, "y": 2140, "width": 631, "height": 39, "text": "score  Low 0 \u00b7 Moderate 1 \u00b7 High 2 \u00b7 Severe 3 \u00b7 No Travel 4\nwind = sustained 10 m wind (gusts shown, not scored) \u00b7 rain = rain + showers", "fontSize": 15, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "diamond", "id": "diamond_176", "x": 900, "y": 1970, "width": 200, "height": 120, "strokeWidth": 2, "strokeColor": "#1e1e1e", "backgroundColor": "#ffffff"}, {"type": "text", "id": "text_177", "x": 959.0, "y": 2020.0, "width": 86, "height": 19, "text": "wind \u2265 55?", "fontSize": 15, "fontFamily": 5}, {"type": "arrow", "id": "arrow_178", "x": 1000, "y": 2090, "width": 0, "height": 70, "points": [[0, 0], [0, 70]], "endArrowhead": "arrow", "strokeWidth": 2, "strokeColor": "#e03131"}, {"type": "text", "id": "text_179", "x": 1010, "y": 2110, "width": 27, "height": 18, "text": "yes", "fontSize": 14, "fontFamily": 5, "strokeColor": "#e03131"}, {"type": "text", "id": "text_180", "x": 930, "y": 2170, "width": 191, "height": 22, "text": "No Travel (any load)", "fontSize": 17, "fontFamily": 5, "strokeColor": "#e03131"}, {"type": "diamond", "id": "diamond_181", "x": 1230, "y": 1970, "width": 200, "height": 120, "strokeWidth": 2, "strokeColor": "#1e1e1e", "backgroundColor": "#ffffff"}, {"type": "text", "id": "text_182", "x": 1264.0, "y": 2010.0, "width": 136, "height": 39, "text": "wind 45\u201354\nand > 30,000 lb?", "fontSize": 15, "fontFamily": 5}, {"type": "arrow", "id": "arrow_183", "x": 1330, "y": 2090, "width": 0, "height": 70, "points": [[0, 0], [0, 70]], "endArrowhead": "arrow", "strokeWidth": 2, "strokeColor": "#e03131"}, {"type": "text", "id": "text_184", "x": 1340, "y": 2110, "width": 27, "height": 18, "text": "yes", "fontSize": 14, "fontFamily": 5, "strokeColor": "#e03131"}, {"type": "text", "id": "text_185", "x": 1260, "y": 2170, "width": 88, "height": 22, "text": "No Travel", "fontSize": 17, "fontFamily": 5, "strokeColor": "#e03131"}, {"type": "diamond", "id": "diamond_186", "x": 1560, "y": 1970, "width": 200, "height": 120, "strokeWidth": 2, "strokeColor": "#1e1e1e", "backgroundColor": "#ffffff"}, {"type": "text", "id": "text_187", "x": 1594.0, "y": 2010.0, "width": 136, "height": 39, "text": "wind 35\u201344\nand > 40,000 lb?", "fontSize": 15, "fontFamily": 5}, {"type": "arrow", "id": "arrow_188", "x": 1660, "y": 2090, "width": 0, "height": 70, "points": [[0, 0], [0, 70]], "endArrowhead": "arrow", "strokeWidth": 2, "strokeColor": "#e8590c"}, {"type": "text", "id": "text_189", "x": 1670, "y": 2110, "width": 27, "height": 18, "text": "yes", "fontSize": 14, "fontFamily": 5, "strokeColor": "#e8590c"}, {"type": "text", "id": "text_190", "x": 1590, "y": 2170, "width": 60, "height": 22, "text": "Severe", "fontSize": 17, "fontFamily": 5, "strokeColor": "#e8590c"}, {"type": "arrow", "id": "arrow_191", "x": 1100, "y": 2030, "width": 130, "height": 0, "points": [[0, 0], [130, 0]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "text", "id": "text_192", "x": 1140, "y": 2000, "width": 19, "height": 18, "text": "no", "fontSize": 14, "fontFamily": 5}, {"type": "arrow", "id": "arrow_193", "x": 1430, "y": 2030, "width": 130, "height": 0, "points": [[0, 0], [130, 0]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "text", "id": "text_194", "x": 1470, "y": 2000, "width": 19, "height": 18, "text": "no", "fontSize": 14, "fontFamily": 5}, {"type": "arrow", "id": "arrow_195", "x": 1760, "y": 2030, "width": 100, "height": 0, "points": [[0, 0], [100, 0]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "text", "id": "text_196", "x": 1800, "y": 2000, "width": 19, "height": 18, "text": "no", "fontSize": 14, "fontFamily": 5}, {"type": "text", "id": "text_197", "x": 1870, "y": 2018, "width": 153, "height": 22, "text": "keep table level", "fontSize": 17, "fontFamily": 5}, {"type": "text", "id": "text_198", "x": 900, "y": 2220, "width": 787, "height": 19, "text": "stop level = worst of wind (after load), rain, snow \u00b7 load_raised = true when a load rule fired", "fontSize": 15, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_199", "x": 0, "y": 2330, "width": 439, "height": 46, "text": "PICKING THE BEST ROUTE", "fontSize": 36, "fontFamily": 5}, {"type": "text", "id": "text_200", "x": 0, "y": 2378, "width": 736, "height": 23, "text": "compare one rule at a time; the next rule only matters when the routes tie", "fontSize": 18, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "line", "id": "line_201", "x": 10, "y": 2490, "width": 1, "height": 1, "points": [[0, 0], [1160, 0]], "strokeWidth": 2, "strokeColor": "#1e1e1e"}, {"type": "ellipse", "id": "ellipse_202", "x": 23, "y": 2483, "width": 14, "height": 14, "strokeWidth": 1, "strokeColor": "#1e1e1e", "backgroundColor": "#1e1e1e"}, {"type": "text", "id": "text_203", "x": 0, "y": 2452, "width": 219, "height": 22, "text": "0 \u00b7 fewest No Travel mi", "fontSize": 17, "fontFamily": 5}, {"type": "text", "id": "text_204", "x": 0, "y": 2508, "width": 181, "height": 36, "text": "our addition: the brief\nskips No Travel", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "ellipse", "id": "ellipse_205", "x": 303, "y": 2483, "width": 14, "height": 14, "strokeWidth": 1, "strokeColor": "#1e1e1e", "backgroundColor": "#1e1e1e"}, {"type": "text", "id": "text_206", "x": 280, "y": 2452, "width": 191, "height": 22, "text": "1 \u00b7 fewest Severe mi", "fontSize": 17, "fontFamily": 5}, {"type": "text", "id": "text_207", "x": 280, "y": 2508, "width": 96, "height": 18, "text": "brief rule 1", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "ellipse", "id": "ellipse_208", "x": 583, "y": 2483, "width": 14, "height": 14, "strokeWidth": 1, "strokeColor": "#1e1e1e", "backgroundColor": "#1e1e1e"}