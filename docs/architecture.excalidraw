, "width": 604, "height": 16, "text": "checkpoints \u00b7 eta \u00b7 forecast \u00b7 risk \u00b7 scoring \u00b7 recommendation  (pure rules, no I/O)", "fontSize": 13, "fontFamily": 1, "strokeColor": "#495057"}, {"type": "arrow", "id": "arrow_72", "x": 990, "y": 790, "width": 0, "height": 30, "points": [[0, 0], [0, 30]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "rectangle", "id": "rectangle_73", "x": 670, "y": 930, "width": 640, "height": 80, "strokeWidth": 1, "strokeColor": "#000000", "backgroundColor": "#eeeeee"}, {"type": "text", "id": "text_74", "x": 682, "y": 938, "width": 74, "height": 20, "text": "adapters", "fontSize": 16, "fontFamily": 1}, {"type": "text", "id": "text_75", "x": 682, "y": 970, "width": 540, "height": 16, "text": "osrm \u00b7 open_meteo \u00b7 photon \u00b7 cached_weather \u00b7 http (timeouts, retries, 429)", "fontSize": 13, "fontFamily": 1, "strokeColor": "#495057"}, {"type": "arrow", "id": "arrow_76", "x": 990, "y": 900, "width": 0, "height": 30, "points": [[0, 0], [0, 30]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "text", "id": "text_77", "x": 675, "y": 1050, "width": 681, "height": 18, "text": "Django 5 + DRF on gunicorn (2 workers \u00d7 4 threads) \u00b7 settings only read in config/env.py", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "rectangle", "id": "rectangle_78", "x": 1360, "y": 600, "width": 320, "height": 100, "strokeWidth": 1, "strokeColor": "#000000", "backgroundColor": "#eeeeee"}, {"type": "text", "id": "text_79", "x": 1372, "y": 608, "width": 92, "height": 20, "text": "WhiteNoise", "fontSize": 16, "fontFamily": 1}, {"type": "text", "id": "text_80", "x": 1372, "y": 640, "width": 182, "height": 33, "text": "serves / and /app/\n(the built frontend/dist)", "fontSize": 13, "fontFamily": 1, "strokeColor": "#495057"}, {"type": "diamond", "id": "diamond_81", "x": 1424, "y": 810, "width": 16, "height": 12, "strokeWidth": 1, "strokeColor": "#e03131", "backgroundColor": "#e03131"}, {"typ