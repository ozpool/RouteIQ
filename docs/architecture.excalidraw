{"type": "excalidraw", "version": 2, "source": "https://excalidraw.com", "elements": [{"type": "text", "id": "text_1", "x": 0, "y": 0, "width": 899, "height": 57, "text": "ROUTEIQ \u00b7 WEATHER-AWARE TRUCK ROUTING", "fontSize": 44, "fontFamily": 5}, {"type": "text", "id": "text_2", "x": 0, "y": 62, "width": 1478, "height": 26, "text": "React + Django app that picks the safest of 3 routes using the forecast at the truck's ETA, the brief's risk table and the load weight", "fontSize": 20, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_3", "x": 0, "y": 150, "width": 518, "height": 46, "text": "THE WHOLE IDEA IN ONE LINE", "fontSize": 36, "fontFamily": 5}, {"type": "text", "id": "text_4", "x": 0, "y": 198, "width": 439, "height": 23, "text": "every request walks this path, left to right", "fontSize": 18, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "line", "id": "line_5", "x": 10, "y": 300, "width": 1, "height": 1, "points": [[0, 0], [2020, 0]], "strokeWidth": 2, "strokeColor": "#1e1e1e"}, {"type": "ellipse", "id": "ellipse_6", "x": 23, "y": 293, "width": 14, "height": 14, "strokeWidth": 1, "strokeColor": "#1e1e1e", "backgroundColor": "#1e1e1e"}, {"type": "text", "id": "text_7", "x": 0, "y": 262, "width": 134, "height": 22, "text": "1 \u00b7 enter trip", "fontSize": 17, "fontFamily": 5}, {"type": "text", "id": "text_8", "x": 0, "y": 318, "width": 150, "height": 36, "text": "origin, destination\ndeparture, load lb", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "ellipse", "id": "ellipse_9", "x": 353, "y": 293, "width": 14, "height": 14, "strokeWidth": 1, "strokeColor": "#1e1e1e", "backgroundColor": "#1e1e1e"}, {"type": "text", "id": "text_10", "x": 330, "y": 262, "width": 116, "height": 22, "text": "2 \u00b7 3 routes", "fontSize": 17, "fontFamily": 5}, {"type": "text", "id": "text_11", "x": 330, "y": 318, "width": 134, "height": 36, "text": "OSRM alternatives\n+ detour routes", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "ellipse", "id": "ellipse_12", "x": 683, "y": 293, "width": 14, "height": 14, "strokeWidth": 1, "strokeColor": "#1e1e1e", "backgroundColor": "#1e1e1e"}, {"type": "text", "id": "text_13", "x": 660, "y": 262, "width": 144, "height": 22, "text": "3 \u00b7 checkpoints", "fontSize": 17, "fontFamily": 5}, {"type": "text", "id": "text_14", "x": 660, "y": 318, "width": 165, "height": 36, "text": "every 10 / 25 / 50 mi\nwith an ETA each", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "ellipse", "id": "ellipse_15", "x": 1013, "y": 293, "width": 14, "height": 14, "strokeWidth": 1, "strokeColor": "#1e1e1e", "backgroundColor": "#1e1e1e"}, {"type": "text", "id": "text_16", "x": 990, "y": 262, "width": 172, "height": 22, "text": "4 \u00b7 weather at ETA", "fontSize": 17, "fontFamily": 5}, {"type": "text", "id": "text_17", "x": 990, "y": 318, "width": 150, "height": 36, "text": "Open-Meteo hourly\nforecast, that hour", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "ellipse", "id": "ellipse_18", "x": 1343, "y": 293, "width": 14, "height": 14, "strokeWidth": 1, "strokeColor": "#1e1e1e", "backgroundColor": "#1e1e1e"}, {"type": "text", "id": "text_19", "x": 1320, "y": 262, "width": 78, "height": 22, "text": "5 \u00b7 risk", "fontSize": 17, "fontFamily": 5}, {"type": "text", "id": "text_20", "x": 1320, "y": 318, "width": 142, "height": 36, "text": "wind / rain / snow\ntable + load rules", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "ellipse", "id": "ellipse_21", "x": 1673, "y": 293, "width": 14, "height": 14, "strokeWidth": 1, "strokeColor": "#1e1e1e", "backgroundColor": "#1e1e1e"}, {"type": "text", "id": "text_22", "x": 1650, "y": 262, "width": 78, "height": 22, "text": "6 \u00b7 rank", "fontSize": 17, "fontFamily": 5}, {"type": "text", "id": "text_23", "x": 1650, "y": 318, "width": 196, "height": 36, "text": "No Travel \u2192 Severe \u2192 High\n\u2192 risk-miles \u2192 time", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "ellipse", "id": "ellipse_24", "x": 2003, "y": 293, "width": 14, "height": 14, "strokeWidth": 1, "strokeColor": "#1e1e1e", "backgroundColor": "#1e1e1e"}, {"type": "text", "id": "text_25", "x": 1980, "y": 262, "width": 78, "height": 22, "text": "7 \u00b7 show", "fontSize": 17, "fontFamily": 5}, {"type": "text", "id": "text_26", "x": 1980, "y": 318, "width": 142, "height": 36, "text": "map, cards, table,\n0\u201348 h heatmap", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_27", "x": 0, "y": 450, "width": 360, "height": 46, "text": "HOW THE PIECES FIT", "fontSize": 36, "fontFamily": 5}, {"type": "text", "id": "text_28", "x": 0, "y": 498, "width": 1083, "height": 23, "text": "one Docker container serves the landing page, the React app and the API; only free public providers behind it", "fontSize": 18, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "ellipse", "id": "ellipse_29", "x": 12, "y": 680, "width": 25, "height": 22, "strokeWidth": 2, "backgroundColor": "#ced4da", "fillStyle": "cross-hatch", "roughness": 0}, {"type": "line", "id": "line_30", "x": 0, "y": 742, "width": 49, "height": 36, "strokeWidth": 2, "backgroundColor": "#ced4da", "fillStyle": "cross-hatch", "roughness": 0, "roundness": {"type": 2}, "points": [[0, 0], [4, -22], [24, -36], [45, -22], [49, 0], [0, 0]]}, {"type": "text", "id": "text_31", "x": -26, "y": 748, "width": 63, "height": 23, "text": "driver", "fontSize": 18, "fontFamily": 5}, {"type": "arrow", "id": "arrow_32", "x": 55, "y": 710, "width": 30, "height": 0, "points": [[0, 0], [30, 0]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "rectangle", "id": "rectangle_33", "x": 90, "y": 560, "width": 470, "height": 440, "strokeWidth": 1, "strokeColor": "#1e1e1e", "backgroundColor": "#ffffff", "roundness": {"type": 3}}, {"type": "text", "id": "text_34", "x": 105, "y": 570, "width": 317, "height": 19, "text": "browser \u00b7 React 18 +