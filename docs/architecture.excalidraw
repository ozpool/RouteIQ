#868e96", "backgroundColor": "#eeeeee"}, {"type": "rectangle", "id": "rectangle_306", "x": 580, "y": 3546, "width": 60, "height": 46, "strokeWidth": 1, "strokeColor": "#868e96", "backgroundColor": "#eeeeee"}, {"type": "rectangle", "id": "rectangle_307", "x": 640, "y": 3446, "width": 60, "height": 46, "strokeWidth": 1, "strokeColor": "#868e96", "backgroundColor": "#eeeeee"}, {"type": "rectangle", "id": "rectangle_308", "x": 640, "y": 3492, "width": 60, "height": 46, "strokeWidth": 1, "strokeColor": "#868e96", "backgroundColor": "#eeeeee"}, {"type": "rectangle", "id": "rectangle_309", "x": 640, "y": 3538, "width": 60, "height": 46, "strokeWidth": 1, "strokeColor": "#868e96", "backgroundColor": "#eeeeee"}, {"type": "rectangle", "id": "rectangle_310", "x": 700, "y": 3438, "width": 60, "height": 46, "strokeWidth": 1, "strokeColor": "#868e96", "backgroundColor": "#eeeeee"}, {"type": "rectangle", "id": "rectangle_311", "x": 700, "y": 3484, "width": 60, "height": 46, "strokeWidth": 1, "strokeColor": "#868e96", "backgroundColor": "#eeeeee"}, {"type": "rectangle", "id": "rectangle_312", "x": 700, "y": 3530, "width": 60, "height": 46, "strokeWidth": 1, "strokeColor": "#868e96", "backgroundColor": "#eeeeee"}, {"type": "rectangle", "id": "rectangle_313", "x": 280, "y": 3586, "width": 60, "height": 46, "strokeWidth": 3, "strokeColor": "#e03131"}, {"type": "line", "id": "line_314", "x": 70, "y": 3595, "width": 1, "height": 1, "points": [[0, 0], [60, -8], [120, -16], [180, -24], [240, -32], [300, -40], [360, -48], [420, -56], [480, -64], [540, -72], [600, -80], [660, -88]], "strokeWidth": 4, "strokeColor": "#1e1e1e"}, {"type": "text", "id": "text_315", "x": 320, "y": 3672, "width": 496, "height": 18, "text": "red edge: a Severe cell at this hour \u00b7 darker grey = higher risk", "fontSize": 14, "fontFamily": 5, "strokeColor": "#e03131"}, {"type": "text", "id": "text_316", "x": 40, "y": 3710, "width": 206, "height": 20, "text": "+9h 38m \u00b7 Sat 01:07 IST", "fontSize": 16, "fontFamily": 5}, {"type": "rectangle", "id": "rectangle_317", "x": 40, "y": 3750, "width": 38, "height": 32, "strokeWidth": 1, "strokeColor": "#1e1e1e", "roundness": {"type": 3}}, {"type": "text", "id": "text_318", "x": 54, "y": 3757, "width": 11, "height": 16, "text": "\u23ee", "fontSize": 13, "fontFamily": 5}, {"type": "rectangle", "id": "rectangle_319", "x": 88, "y": 3750, "width": 38, "height": 32, "strokeWidth": 2, "strokeColor": "#1e1e1e", "roundness": {"type": 3}}, {"type": "text", "id": "text_320", "x": 102, "y": 3757, "width": 11, "height": 16, "text": "\u25b6", "fontSize": 13, "fontFamily": 5}, {"type": "rectangle", "id": "rectangle_321", "x": 136, "y": 3750, "width": 38, "height": 32, "strokeWidth": 1, "strokeColor": "#1e1e1e", "roundness": {"type": 3}}, {"type": "text", "id": "text_322", "x": 150, "y": 3757, "width": 11, "height": 16, "text": "\u23ed", "fontSize": 13, "fontFamily": 5}, {"type": "line", "id": "line_323", "x": 190, "y": 3766, "width": 1, "height": 1, "points": [[0, 0], [550, 0]], "strokeWidth": 3}, {"type": "ellipse", "id": "ellipse_324", "x": 380, "y": 3757, "width": 18, "height": 18, "strokeWidth": 1, "strokeColor": "#1e1e1e", "backgroundColor": "#1e1e1e"}, {"type": "line", "id": "line_325", "x": 210, "y": 3778, "width": 1, "height": 1, "points": [[0, 0], [0, 8]], "strokeWidth": 2, "strokeColor": "#868e96"}, {"type": "line", "id": "line_326", "x": 248, "y": 3778, "width": 1, "height": 1, "points": [[0, 0], [0, 8]], "strokeWidth": 2, "strokeColor": "#868e96"}, {"type": "line", "id": "line_327", "x": 286, "y": 3778, "width": 1, "height": 1, "points": [[0, 0], [0, 8]], "strokeWidth": 2, "strokeColor": "#868e96"}, {"type": "line", "id": "line_328", "x": 324, "y": 3778, "width": 1, "height": 1, "points": [[0, 0], [0, 8]], "strokeWidth": 2, "strokeColor": "#868e96"}, {"type": "line", "id": "line_329", "x": 362, "y": 3778, "width": 1, "height": 1, "points": [[0, 0], [0, 8]], "strokeWidth": 2, "strokeColor": "#868e96"}, {"type": "line", "id": "line_330", "x": 400, "y": 3778, "width": 1, "height": 1, "points": [[0, 0], [0, 8]], "strokeWidth": 2, "strokeColor": "#e03131"}, {"type": "line", "id": "line_331", "x": 438, "y": 3778, "width": 1, "height": 1, "points": [[0, 0], [0, 8]], "strokeWidth": 2, "strokeColor": "#868e96"}, {"type": "line", "id": "line_332", "x": 476, "y": 3778, "width": 1, "height": 1, "points": [[0, 0], [0, 8]], "strokeWidth": 2, "strokeColor": "#868e96"}, {"type": "line", "id": "line_333", "x": 514, "y": 3778, "width": 1, "height": 1, "points": [[0, 0], [0, 8]], "strokeWidth": 2, "strokeColor": "#868e96"}, {"type": "line", "id": "line_334", "x": 552, "y": 3778, "width": 1, "height": 1, "points": [[0, 0], [0, 8]], "strokeWidth": 2, "strokeColor": "#868e96"}, {"type": "line", "id": "line_335", "x": 590, "y": 3778, "width": 1, "height": 1, "points": [[0, 0], [0, 8]], "strokeWidth": 2, "strokeColor": "#868e96"}, {"type": "line", "id": "line_336", "x": 628, "y": 3778, "width": 1, "height": 1, "points": [[0, 0], [0, 8]], "strokeWidth": 2, "strokeColor": "#868e96"}, {"type": "text", "id": "text_337", "x": 190, "y": 3796, "width": 519, "height": 18, "text": "ticks = checkpoint ETAs, coloured by risk \u00b7 0\u201348 h, 15-minute steps", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_338", "x": 40, "y": 3830, "width": 735, "height": 18, "text": "\u23ee / \u23ed jump to the previous / next checkpoint and open its weather \u00b7 \u25b6 steps through all of them", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "arrow", "id": "arrow_339", "x": 785, "y": 3766, "width": 215, "height": 0, "points": [[0, 0], [215, 0]], "endArrowhead": "arrow", "strokeWidth": 2, "strokeStyle": "dashed"}, {"type": "text", "id": "text_340", "x": 800, "y": 3738, "width": 88, "height": 18, "text": "slider step", "fontSize": 14, "fontFamily": 5}, {"type": "line", "id": "line_341", "x": 880, "y": 3752, "width": 28, "height": 28, "strokeWidth": 4, "strokeColor": "#e03131", "points": [[0, 0], [28, 28]]}, {"type": "line", "id": "line_342", "x": 908, "y": 3752, "width": 28, "height": 28, "strokeWidth": 4, "strokeColor": "#e03131", "points": [[0, 0], [-28, 28]]}, {"type": "text", "id": "text_343", "x": 1010, "y": 3754, "width": 97, "height": 22, "text": "Django API", "fontSize": 17, "fontFamily": 5}, {"type": "text", "id": "text_344", "x": 860, "y": 3800, "width": 391, "height": 39, "text": "no request: every hour is already on each cell,\nso a step only changes the layer's fill colour", "fontSize": 15, "fontFamily": 5, "strokeColor": "#e03131"}, {"type": "text", "id": "text_345", "x": 880, "y": 3410, "width": 161, "height": 28, "text": "ONCE PER TRIP", "fontSize": 22, "fontFamily": 5}, {"type": "text", "id": "text_346", "x": 880, "y": 3450, "width": 573, "height": 58, "text": "POST /api/trips/heatmap\n{ \"lines\": [[[-96.80, 32.78], \u2026], \u2026],   \u2264 3 lines, \u2264 5000 points\n  \"departure_time\": \"2026-10-24T14:00:00Z\", \"load_weight_lb\": 42000 }", "fontSize": 15, "fontFamily": 5}, {"type": "arrow", "id": "arrow_347", "x": 900, "y": 3525, "width": 0, "height": 35, "points": [[0, 0], [0, 35]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "text", "id": "text_348", "x": 880, "y": 3570, "width": 433, "height": 78, "text": "{ \"start_time\": \"2026-10-24T14:00:00Z\", \"hours\": 49,\n  \"cell_size_deg\": 0.5,\n  \"cells\": [[-96.75, 32.75], [-96.25, 32.75], \u2026],\n  \"risk\":  [[0, 0, 1, 1, 2, \u202649 scores], \u2026] }", "fontSize": 15, "fontFamily": 5}, {"type": "text", "id": "text_349", "x": 880, "y": 3670, "width": 655, "height": 19, "text": "cells come from the same grid as the checkpoint lookups, so most are cache hits", "fontSize": 15, "fontFamily": 5, "strokeColor": "#2f9e44"}, {"type": "text", "id": "text_350", "x": 880, "y": 3694, "width": 499, "height": 39, "text": "why cells, not a density heatmap: overlapping points add up,\nso two Moderate cells side by side would look Severe", "fontSize": 15, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_351", "x": 0, "y": 3930, "width": 281, "height": 46, "text": "6 \u00b7 OPERATIONS", "fontSize": 36, "fontFamily": 5}, {"type": "text", "id": "text_352", "x": 0, "y": 3980, "width": 1280, "height": 26, "text": "One health endpoint for the platform and the uptime monitor. It never calls a provider, and it never fails over one.", "fontSize": 20, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "rectangle", "id": "rectangle_353", "x": 0, "y": 4080, "width": 380, "height": 110, "strokeWidth": 2, "strokeColor": "#1e1e1e", "backgroundColor": "#ffffff", "roundness": {"type": 3}}, {"type": "text", "id": "text_354", "x": 20, "y": 4094, "width": 125, "height": 26, "text": "UptimeRobot", "fontSize": 20, "fontFamily": 5}, {"type": "text", "id": "text_355", "x": 20, "y": 4134, "width": 303, "height": 41, "text": "HEAD /api/health every few minutes\npublic status page", "fontSize": 16, "fontFamily": 5}, {"type": "rectangle", "id": "rectangle_356", "x": 0, "y": 4230, "width": 380, "height": 110, "strokeWidth": 2, "strokeColor": "#1e1e1e", "backgroundColor": "#ffffff", "roundness": {"type": 3}}, {"type": "text", "id": "text_357", "x": 20, "y": 4244, "width": 213, "height": 26, "text": "Render health check", "fontSize": 20, "fontFamily": 5}, {"type": "text", "id": "text_358", "x": 20, "y": 4284, "width": 259, "height": 41, "text": "GET /api/health\nrestarts the app on a non-200", "fontSize": 16, "fontFamily": 5}, {"type": "rectangle", "id": "rectangle_359", "x": 520, "y": 4135, "width": 290, "height": 95, "strokeWidth": 2, "strokeColor": "#2f9e44", "backgroundColor": "#eeeeee"}, {"type": "text", "id": "text_360", "x": 532, "y": 4143, "width": 100, "height": 20, "text": "/api/health", "fontSize": 16, "fontFamily": 1, "strokeColor": "#2f9e44"}, {"type": "text", "id": "text_361", "x": 532, "y": 4175, "width": 211, "height": 33, "text": "one handler for GET and HEAD\nalways 200 \u00b7 HEAD has no body", "fontSize": 13, "fontFamily": 1, "strokeColor": "#495057"}, {"type": "arrow", "id": "arrow_362", "x": 385, "y": 4135, "width": 130, "height": 30, "points": [[0, 0], [130, 30]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "text", "id": "text_363", "x": 420, "y": 4120, "width": 34, "height": 18, "text": "HEAD", "fontSize": 14, "fontFamily": 5}, {"type": "arrow", "id": "arrow_364", "x": 385, "y": 4285, "width": 130, "height": 80, "points": [[0, 0], [130, -80]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "text", "id": "text_365", "x": 420, "y": 4260, "width": 27, "height": 18, "text": "GET", "fontSize": 14, "fontFamily": 5}, {"type": "text", "id": "text_366", "x": 900, "y": 4080, "width": 581, "height": 136, "text": "{ \"status\": \"ok\",          \u2190 \"degraded\" when a service fails\n  \"services\": {\n    \"routing\":   { \"provider\": \"OSRM\",       \"status\": \"ok\" },\n    \"weather\":   { \"provider\": \"Open-Meteo\", \"status\": \"rate_limited\",\n                   \"last_error\": { \"message\": \"HTTP 429: \u2026\" } },\n    \"geocoding\": { \"provider\": \"Photon\",     \"status\": \"unknown\" },\n    \"cache\":     { \"backend\": \"in-memory\",   \"status\": \"ok\" } } }", "fontSize": 15, "fontFamily": 5}, {"type": "arrow", "id": "arrow_367", "x": 815, "y": 4182, "width": 75, "height": 0, "points": [[0, 0], [75, 0]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "text", "id": "text_368", "x": 520, "y": 4270, "width": 598, "height": 39, "text": "provider status is recorded from real traffic in the shared HTTP client:\nno provider call and no quota spent per check", "fontSize": 15, "fontFamily": 5, "strokeColor": "#2f9e44"}, {"type": "text", "id": "text_369", "x": 520, "y": 4330, "width": 482, "height": 39, "text": "a failing provider shows in the body, not the status code,\nso Render never restarts the app over a provider outage", "fontSize": 15, "fontFamily": 5, "strokeColor": "#e03131"}, {"type": "text", "id": "text_370", "x": 520, "y": 4390, "width": 523, "height": 19, "text": "gunicorn would send a body on HEAD; a small middleware drops it", "fontSize": 15, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_371", "x": 0, "y": 4460, "width": 730, "height": 19, "text": "CI on every pull request: ruff \u00b7 pytest (126) \u00b7 tsc \u00b7 vitest (39) \u00b7 build \u00b7 Docker build", "fontSize": 15, "fontFamily": 5}], "appState": {"viewBackgroundColor": "#ffffff", "gridSize": 20}, "files": {"file_react_orig": {"mimeType": "image/svg+xml", "id": "file_react_orig", "created": 1, "dataURL": "data:image/svg+xml;base64,"}, "file_vite_orig": {"mimeType": "image/svg+xml", "id": "file_vite_orig", "created": 1, "dataURL": "data:image/svg+xml;base64,"}, "file_maplibre_orig": {"mimeType": "image/svg+xml", "id": "file_maplibre_orig", "created": 1, "dataURL": "data:image/svg+xml;base64,"}, "file_reactquery_orig": {"mimeType": "image/svg+xml", "id": "file_reactquery_orig", "created": 1, "dataURL": "data:image/svg+xml;base64,"}, "file_django_orig": {"mimeType": "image/svg+xml", "id": "file_django_orig", "created": 1, "dataURL": "data:image/svg+xml;base64,"}, "file_openstreetmap_orig": {"mimeType": "image/svg+xml", "id": "file_openstreetmap_orig", "created": 1, "dataURL": "data:image/svg+xml;base64,"}}}