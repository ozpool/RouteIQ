{"type": "excalidraw", "version": 2, "source": "https://excalidraw.com", "elements": [{"type": "text", "id": "text_1", "x": 0, "y": 0, "width": 536, "height": 57, "text": "ROUTEIQ \u00b7 HOW IT WORKS", "fontSize": 44, "fontFamily": 5}, {"type": "text", "id": "text_2", "x": 0, "y": 62, "width": 1214, "height": 26, "text": "Weather-aware truck routing: three routes, the forecast at each checkpoint's ETA, a ranked pick with a reason.", "fontSize": 20, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_3", "x": 0, "y": 150, "width": 281, "height": 46, "text": "1 \u00b7 THE SYSTEM", "fontSize": 36, "fontFamily": 5}, {"type": "text", "id": "text_4", "x": 0, "y": 200, "width": 1159, "height": 26, "text": "One container serves the app and the API. Every outside service is free and keyless, behind an interface.", "fontSize": 20, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "ellipse", "id": "ellipse_5", "x": 22, "y": 480, "width": 25, "height": 22, "strokeWidth": 2, "backgroundColor": "#ced4da", "fillStyle": "cross-hatch", "roughness": 0}, {"type": "line", "id": "line_6", "x": 10, "y": 542, "width": 49, "height": 36, "strokeWidth": 2, "backgroundColor": "#ced4da", "fillStyle": "cross-hatch", "roughness": 0, "roundness": {"type": 2}, "points": [[0, 0], [4, -22], [24, -36], [45, -22], [49, 0], [0, 0]]}, {"type": "text", "id": "text_7", "x": -16, "y": 548, "width": 122, "height": 23, "text": "Truck driver", "fontSize": 18, "fontFamily": 5}, {"type": "rectangle", "id": "rectangle_8", "x": 120, "y": 350, "width": 320, "height": 290, "strokeWidth": 1, "strokeColor": "#1e1e1e", "backgroundColor": "#ffffff", "roundness": {"type": 3}}, {"type": "text", "id": "text_9", "x": 135, "y": 360, "width": 61, "height": 19, "text": "browser", "fontSize": 15, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "image", "id": "image_10", "x": 140, "y": 395, "width": 28, "height": 28.0, "fileId": "file_react_orig", "status": "saved", "scale": [1, 1], "strokeColor": "