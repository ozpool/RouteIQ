"text": "WHY STEP 4 IS A TOTAL, NOT A PER-MILE AVERAGE", "fontSize": 22, "fontFamily": 5}, {"type": "text", "id": "text_245", "x": 700, "y": 3022, "width": 713, "height": 19, "text": "live run, Seattle \u2192 Minneapolis, before the fix: same bad miles, one route much longer", "fontSize": 15, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "rectangle", "id": "rectangle_246", "x": 700, "y": 3060, "width": 710, "height": 88, "strokeWidth": 1, "strokeColor": "#1e1e1e", "backgroundColor": "#ffffff"}, {"type": "line", "id": "line_247", "x": 700, "y": 3090, "width": 710, "height": 0, "strokeWidth": 1, "points": [[0, 0], [710, 0]]}, {"type": "text", "id": "text_248", "x": 710, "y": 3066, "width": 42, "height": 18, "text": "route", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_249", "x": 710, "y": 3096, "width": 12, "height": 19, "text": "A", "fontSize": 15, "fontFamily": 5}, {"type": "text", "id": "text_250", "x": 710, "y": 3122, "width": 12, "height": 19, "text": "C", "fontSize": 15, "fontFamily": 5}, {"type": "line", "id": "line_251", "x": 790, "y": 3060, "width": 0, "height": 88, "strokeWidth": 1, "points": [[0, 0], [0, 88]]}, {"type": "text", "id": "text_252", "x": 800, "y": 3066, "width": 65, "height": 18, "text": "distance", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_253", "x": 800, "y": 3096, "width": 70, "height": 19, "text": "1,656 mi", "fontSize": 15, "fontFamily": 5}, {"type": "text", "id": "text_254", "x": 800, "y": 3122, "width": 70, "height": 19, "text": "1,807 mi", "fontSize": 15, "fontFamily": 5}, {"type": "line", "id": "line_255", "x": 910, "y": 3060, "width": 0, "height": 88, "strokeWidth": 1, "points": [[0, 0], [0, 88]]}, {"type": "text", "id": "text_256", "x": 920, "y": 3066, "width": 81, "height": 18, "text": "drive time", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_257", "x": 920, "y": 3096, "width": 53, "height": 19, "text": "28.4 h", "fontSize": 15, "fontFamily": 5}, {"type": "text", "id": "text_258", "x": 920, "y": 3122, "width": 53, "height": 19, "text": "34.7 h", "fontSize": 15, "fontFamily": 5}, {"type": "line", "id": "line_259", "x": 1030, "y": 3060, "width": 0, "height": 88, "strokeWidth": 1, "points": [[0, 0], [0, 88]]}, {"type": "text", "id": "text_260", "x": 1040, "y": 3066, "width": 88, "height": 18, "text": "Moderate mi", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_261", "x": 1040, "y": 3096, "width": 28, "height": 19, "text": "300", "fontSize": 15, "fontFamily": 5}, {"type": "text", "id": "text_262", "x": 1040, "y": 3122, "width": 28, "height": 19, "text": "300", "fontSize": 15, "fontFamily": 5}, {"type": "line", "id": "line_263", "x": 1170, "y": 3060, "width": 0, "height": 88, "strokeWidth": 1, "points": [[0, 0], [0, 88]]}, {"type": "text", "id": "text_264", "x": 1180, "y": 3066, "width": 81, "height": 18, "text": "avg / mile", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_265", "x": 1180, "y": 3096, "width": 37, "height": 19, "text": "0.18", "fontSize": 15, "fontFamily": 5}, {"type": "text", "id": "text_266", "x": 1180, "y": 3122, "width": 37, "height": 19, "text": "0.17", "fontSize": 15, "fontFamily": 5}, {"type": "line", "id": "line_267", "x": 1290, "y": 3060, "width": 0, "height": 88, "strokeWidth": 1, "points": [[0, 0], [0, 88]]}, {"type": "text", "id": "text_268", "x": 1300, "y": 3066, "width": 81, "height": 18, "text": "risk-miles", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_269", "x": 1300, "y": 3096, "width": 28, "height": 19, "text": "300", "fontSize": 15, "fontFamily": 5}, {"type": "text", "id": "text_270", "x": 1300, "y": 3122, "width": 28, "height": 19, "text": "300", "fontSize": 15, "fontFamily": 5}, {"type": "text", "id": "text_271", "x": 1440, "y": 3070, "width": 334, "height": 39, "text": "per-mile average \u2192 C wins: 6.3 h slower,\nits extra Low miles dilute the same 300", "fontSize": 15, "fontFamily": 5, "strokeColor": "#e03131"}, {"type": "text", "id": "text_272", "x": 1440, "y": 3130, "width": 301, "height": 19, "text": "risk-miles \u2192 tie \u2192 shortest time \u2192 A", "fontSize": 15, "fontFamily": 5, "strokeColor": "#2f9e44"}, {"type": "text", "id": "text_273", "x": 0, "y": 3270, "width": 400, "height": 46, "text": "5 \u00b7 CORRIDOR HEATMAP", "fontSize": 36, "fontFamily": 5}, {"type": "text", "id": "text_274", "x": 0, "y": 3320, "width": 1368, "height": 26, "text": "One request per trip brings all 49 hours. After that the slider, \u23ee \u23ed and \u25b6 only repaint the map; they never call the server.", "fontSize": 20, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "rectangle", "id": "rectangle_275", "x": 0, "y": 3410, "width": 780, "height": 470, "strokeWidth": 1, "strokeColor": "#1e1e1e", "backgroundColor": "#ffffff", "roundness": {"type": 3}}, {"type": "text", "id": "text_276", "x": 15, "y": 3420, "width": 309, "height": 19, "text": "map \u00b7 selected route + corridor cells", "fontSize": 15, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "rectangle", "id": "rectangle_277", "x": 40, "y": 3526, "width": 60, "height": 46, "strokeWidth": 1, "strokeColor": "#868e96", "backgroundColor": "#eeeeee"}, {"type": "rectangle", "id": "rectangle_278", "x": 40, "y": 3572, "width": 60, "height": 46, "strokeWidth": 1, "strokeColor": "#868e96", "backgroundColor": "#eeeeee"}, {"type": "rectangle", "id": "rectangle_279", "x": 40, "y": 3618, "width": 60, "height": 46, "strokeWidth": 1, "strokeColor": "#868e96", "backgroundColor": "#ced4da"}, {"type": "rectangle", "id": "rectangle_280", "x": 100, "y": 3518, "width": 60, "height": 46, "strokeWidth": 1, "strokeColor": "#868e96", "backgroundColor": "#eeeeee"}, {"type": "rectangle", "id": "rectangle_281", "x": 100, "y": 3564, "width": 60, "height": 46, "strokeWidth": 1, "strokeColor": "#868e96", "backgroundColor": "#ced4da"}, {"type": "rectangle", "id": "rectangle_282", "x": 100, "y": 3610, "width": 60, "height": 46, "strokeWidth": 1, "strokeColor": "#868e96", "backgroundColor": "#ced4da"}, {"type": "rectangle", "id": "rectangle_283", "x": 160, "y": 3510, "width": 60, "height": 46, "strokeWidth": 1, "strokeColor": "#868e96", "backgroundColor": "#eeeeee"}, {"type": "rectangle", "id": "rectangle_284", "x": 160, "y": 3556, "width": 60, "height": 46, "strokeWidth": 1, "strokeColor": "#868e96", "backgroundColor": "#ced4da"}, {"type": "rectangle", "id": "rectangle_285", "x": 160, "y": 3602, "width": 60, "height": 46, "strokeWidth": 1, "strokeColor": "#868e96", "backgroundColor": "#ced4da"}, {"type": "rectangle", "id": "rectangle_286", "x": 220, "y": 3502, "width": 60, "height": 46, "strokeWidth": 1, "strokeColor": "#868e96", "backgroundColor": "#ced4da"}, {"type": "rectangle", "id": "rectangle_287", "x": 220, "y": 3548, "width": 60, "height": 46, "strokeWidth": 1, "strokeColor": "#868e96", "backgroundColor": "#868e96"}, {"type": "rectangle", "id": "rectangle_288", "x": 220, "y": 3594, "width": 60, "height": 46, "strokeWidth": 1, "strokeColor": "#868e96", "backgroundColor": "#ced4da"}, {"type": "rectangle", "id": "rectangle_289", "x": 280, "y": 3494, "width": 60, "height": 46, "strokeWidth": 1, "strokeColor": "#868e96", "backgroundColor": "#ced4da"}, {"type": "rectangle", "id": "rectangle_290", "x": 280, "y": 3540, "width": 60, "height": 46, "strokeWidth": 1, "strokeColor": "#868e96", "backgroundColor": "#868e96"}, {"type": "rectangle", "id": "rectangle_291", "x": 280, "y": 3586, "width": 60, "height": 46, "strokeWidth": 1, "strokeColor": "#868e96", "backgroundColor": "#868e96"}, {"type": "rectangle", "id": "rectangle_292", "x": 340, "y": 3486, "width": 60, "height": 46, "strokeWidth": 1, "strokeColor": "#868e96", "backgroundColor": "#eeeeee"}, {"type": "rectangle", "id": "rectangle_293", "x": 340, "y": 3532, "width": 60, "height": 46, "strokeWidth": 1, "strokeColor": "#868e96", "backg