}, {"type": "arrow", "id": "arrow_57", "x": 445, "y": 445, "width": 270, "height": 0, "points": [[0, 0], [270, 0]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "text", "id": "text_58", "x": 460, "y": 417, "width": 158, "height": 18, "text": "POST /api/trips/plan", "fontSize": 14, "fontFamily": 5}, {"type": "arrow", "id": "arrow_59", "x": 445, "y": 490, "width": 270, "height": 0, "points": [[0, 0], [270, 0]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "text", "id": "text_60", "x": 460, "y": 462, "width": 181, "height": 18, "text": "POST /api/trips/heatmap", "fontSize": 14, "fontFamily": 5}, {"type": "arrow", "id": "arrow_61", "x": 715, "y": 590, "width": 270, "height": 0, "points": [[0, 0], [-270, 0]], "endArrowhead": "arrow", "strokeWidth": 2, "strokeStyle": "dashed"}, {"type": "text", "id": "text_62", "x": 470, "y": 562, "width": 188, "height": 18, "text": "landing, planner, assets", "fontSize": 14, "fontFamily": 5}, {"type": "rectangle", "id": "rectangle_63", "x": 1510, "y": 310, "width": 360, "height": 110, "strokeWidth": 2, "strokeColor": "#1e1e1e", "backgroundColor": "#ffffff", "roundness": {"type": 3}}, {"type": "image", "id": "image_64", "x": 1528, "y": 323, "width": 28, "height": 28.0, "fileId": "file_openstreetmap_orig", "status": "saved", "scale": [1, 1], "strokeColor": "transparent", "backgroundColor": "transparent"}, {"type": "text", "id": "text_65", "x": 1566, "y": 324, "width": 48, "height": 26, "text": "OSRM", "fontSize": 20, "fontFamily": 5}, {"type": "text", "id": "text_66", "x": 1530, "y": 364, "width": 259, "height": 41, "text": "routes + up to 3 alternatives\ncar profile, polyline6", "fontSize": 16, "fontFamily": 5}, {"type": "rectangle", "id": "rectangle_67", "x": 1510, "y": 470, "width": 360, "height": 110, "strokeWidth": 2, "strokeColor": "#1e1e1e", "backgroundColor": "#ffffff", "roundness": {"type": 3}}, {"type": "text", "id": "text_68", "x": 1530, "y": 484, "width": 114, "height": 26, "text": "Open-Meteo", "fontSize": 20, "fontFamily": 5}, {"type": "text", "id": "text_69", "x": 1530, "y": 524, "width": 347, "height": 41, "text": "hourly wind \u00b7 rain \u00b7 showers \u00b7 snowfall\n100 points per call", "fontSize": 16, "fontFamily": 5}, {"type": "rectangle", "id": "rectangle_70", "x": 1510, "y": 630, "width": 360, "height": 110, "strokeWidth": 2, "strokeColor": "#1e1e1e", "backgroundColor": "#ffffff", "roundness": {"type": 3}}, {"type": "image", "id": "image_71", "x": 1528, "y": 643, "width": 28, "height": 28.0, "fileId": "file_openstreetmap_orig", "status": "saved", "scale": [1, 1], "strokeColor": "transparent", "backgroundColor": "transparent"}, {"type": "text", "id": "text_72", "x": 1566, "y": 644, "width": 70, "height": 26, "text": "Photon", "fontSize": 20, "fontFamily": 5}, {"type": "text", "id": "text_73", "x": 1530, "y": 684, "width": 259, "height": 20, "text": "place autocomplete (OSM data)", "fontSize": 16, "fontFamily": 5}, {"type": "line", "id": "line_74", "x": 1325, "y": 665, "width": 1, "height": 1, "points": [[0, 0], [130, 0]], "strokeWidth": 2}, {"type": "line", "id": "line_75", "x": 1455, "y": 365, "width": 1, "height": 1, "points": [[0, 0], [0, 320]], "strokeWidth": 2}, {"type": "arrow", "id": "arrow_76", "x": 1455, "y": 365, "width": 50, "height": 0, "points": [[0, 0], [50, 0]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "arrow", "id": "arrow_77", "x": 1455, "y": 525, "width": 50, "height": 0, "points": [[0, 0], [50, 0]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "arrow", "id": "arrow_78", "x": 1455, "y": 685, "width": 50, "height": 0, "points": [[0, 0], [50, 0]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "text", "id": "text_79", "x": 720, "y": 950, "width": 848, "height": 20, "text": "provider 429 \u2192 our 503 with the provider's reason, never retried (quotas don't clear in seconds)", "fontSize": 16, "fontFamily": 5, "strokeColor": "#e03131"}, {"type": "text", "id": "text_80", "x": 720, "y": 978, "width": 496, "height": 20, "text": "a forecast with a missing value \u2192 502, never read as Low", "fontSize": 16, "fontFamily": 5, "strokeColor": "#e03131"}, {"type": "text", "id": "text_81", "x": 720, "y": 1006, "width": 532, "height": 20, "text": "502 / 503 / 504 from a provider \u2192 retried twice with backoff", "fontSize": 16, "fontFamily": 5}, {"type": "text", "id": "text_82", "x": 720, "y": 1034, "width": 646, "height": 20, "text": "weather lookups snap to a shared ~12 mi grid, repeats come from the cache", "fontSize": 16, "fontFamily": 5, "strokeColor": "#2f9e44"}, {"type": "text", "id": "text_83", "x": 0, "y": 1110, "width": 380, "height": 46, "text": "2 \u00b7 PLANNING A TRIP", "fontSize": 36, "fontFamily": 5}, {"type": "text", "id": "text_84", "x": 0, "y": 1160, "width": 1225, "height": 26, "text": "One request in, three scored routes out. The forecast is read for the moment the truck reaches each checkpoint.", "fontSize": 20, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_85", "x": 0, "y": 1250, "width": 391, "height": 156, "text": "POST /api/trips/plan\n{\n  \"origin\":      {\"lat\": 32.78, \"lon\": -96.80},\n  \"destination\": {\"lat\": 41.88, \"lon\": -87.63},\n  \"departure_time\": \"2026-10-24T14:00:00Z\",\n  \"load_weight_lb\": 42000,\n  \"checkpoint_interval_mi\": 25\n}", "fontSize": 15, "fontFamily": 5}, {"type": "arrow", "id": "arrow_86", "x": 400, "y": 1315, "width": 55, "height": 0, "points": [[0, 0], [55, 0]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "line", "id": "line_87", "x": 470, "y": 1315, "width": 1, "height": 1, "points": [[0, 0], [1315, 0]], "strokeWidth": 2, "strokeColor": "#1e1e1e"}, {"type": "ellipse", "id": "ellipse_88", "x": 483, "y": 1308, "width": 14, "height": 14, "strokeWidth": 1, "strokeColor": "#1e1e1e", "backgroundColor": "#1e1e1e"}, {"type": "text", "id": "text_89", "x": 460, "y": 1277, "width": 60, "height": 22, "text": "routes", "fontSize": 17, "fontFamily": 5}, {"type": "ellipse", "id": "ellipse_90", "x": 738, "y": 1308, "width": 14, "height": 14, "strokeWidth": 1, "strokeColor": "#1e1e1e", "backgroundColor": "#1e1e1e"}, {"type": "text", "id": "text_91", "x": 715, "y": 1277, "width": 88, "height": 22, "text": "truck ETA", "fontSize": 17, "fontFamily": 5}, {"type": "text", "id": "text_92", "x": 715, "y": 1333, "width": 142, "height": 54, "text": "each road segment:\nmax(router time,\nmiles \u00f7 65 mph)", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "ellipse", "id": "ellipse_93", "x": 993, "y": 1308, "width": 14, "height": 14, "strokeWidth": 1, "strokeColor": "#1e1e1e", "backgroundColor": "#1e1e1e"}, {"type": "text", "id": "text_94", "x": 970, "y": 1277, "width": 106, "height": 22, "text": "checkpoints", "fontSize": 17, "fontFamily": 5}, {"type": "text", "id": "text_95", "x": 970, "y": 1333, "width": 165, "height": 36, "text": "mile 0, N, 2N \u2026 + end\nN = 10 / 25 / 50", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "ellipse", "id": "ellipse_96", "x": 1248, "y": 1308, "width": 14, "height": 14, "strokeWidth": 1, "strokeColor": "#1e1e1e", "backgroundColor": "#1e1e1e"}, {"type": "text", "id": "text_97", "x": 1225, "y": 1277, "width": 134, "height": 22, "text": "weather at ETA", "fontSize": 17, "fontFamily": 5}, {"type": "text", "id": "text_98", "x": 1225, "y": 1333, "width": 165, "height": 54, "text": "one batched call\nrain: the hour driven\nwind: interpolated", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "ellipse", "id": "ellipse_99", "x": 1503, "y": 1308, "width": 14, "height": 14, "strokeWidth": 1, "strokeColor": "#1e1e1e", "backgroundColor": "#1e1e1e"}, {"type": "text", "id": "text_100", "x": 1480, "y": 1277, "width": 41, "height": 22, "text": "risk", "fontSize": 17, "fontFamily": 5}, {"type": "text", "id": "text_101", "x": 1480, "y": 1333, "width": 196, "height": 36, "text": "thresholds + load rules\nworst of wind, rain, snow", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "ellipse", "id": "ellipse_102", "x": 1758, "y": 1308, "width": 14, "height": 14, "strokeWidth": 1, "strokeColor": "#1e1e1e", "backgroundColor": "#1e1e1e"}, {"type": "text", "id": "text_103", "x": 1735, "y": 1277, "width": 41, "height": 22, "text": "rank", "fontSize": 17, "fontFamily": 5}, {"type": "text", "id": "text_104", "x": 1735, "y": 1333, "width": 196, "height": 36, "text": "No Travel \u2192 Severe \u2192 High\n\u2192 risk-miles \u2192 time", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_105", "x": 505, "y": 1332, "width": 104, "height": 36, "text": "OSRM, up to 3\nalternatives", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "arrow", "id": "arrow_106", "x": 490, "y": 1326, "width": 0, "height": 129, "points": [[0, 0], [0, 129]], "endArrowhead": "arrow", "strokeWidth": 2, "strokeStyle": "dashed"}, {"type": "diamond", "id": "diamond_107", "x": 380, "y": 1460, "width": 220, "height": 110, "strokeWidth": 2, "strokeColor": "#1e1e1e", "backgroundColor": "#ffffff"}, {"type": "text", "id": "text_108", "x": 424.0, "y": 1495.0, "width": 136, "height": 39, "text": "fewer than 3\ndistinct routes?", "fontSize": 15, "fontFamily": 5}, {"type": "rectangle", "id": "rectangle_109", "x": 660, "y": 1455, "width": 270, "height": 130, "strokeWidth": 1, "strokeColor": "#000000", "backgroundColor": "#eeeeee"}, {"type": "text", "id": "text_110", "x": 672, "y": 1463, "width": 153, "height": 20, "text": "detour via-points", "fontSize": 16, "fontFamily": 1}, {"type": "text", "id": "text_111", "x": 672, "y": 1495, "width": 204, "height": 67, "text": "left / right of the midpoint\nfirst \u00b115%, then \u00b130%\ndrop \u2265 80% overlap or\n> 1.75\u00d7 the fastest", "fontSize": 13, "fontFamily": 1, "strokeColor": "#495057"}, {"type": "arrow", "id": "arrow_112", "x": 603, "y": 1515, "width": 52, "height": 0, "points": [[0, 0], [52, 0]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "text", "id": "text_113", "x": 612, "y": 1488, "width": 27, "height": 18, "text": "yes", "fontSize": 14, "fontFamily": 5}, {"type": "arrow", "id": "arrow_114", "x": 795, "y": 1590, "width": 305, "height": 55, "points": [[0, 0], [0, 40], [-305, 40], [-305, -15]], "endArrowhead": "arrow", "strokeWidth": 2, "strokeStyle": "dashed"}, {"type": "text", "id": "text_115", "x": 560, "y": 1635, "width": 88, "height": 18, "text": "check again", "fontSize": 14, "fontFamily": 5}, {"type": "arrow", "id": "arrow_116", "x": 377, "y": 1515, "width": 57, "height": 0, "points": [[0, 0], [-57, 0]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "text", "id": "text_117", "x": 335, "y": 1488, "width": 19, "height": 18, "text": "no", "fontSize": 14, "fontFamily": 5}, {"type": "text", "id": "text_118", "x": 0, "y": 1500, "width": 251, "height": 39, "text": "carry on with what exists;\nfewer than 3 \u2192 said in notes[]", "fontSize": 15, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "arrow", "id": "arrow_119", "x": 1748, "y": 1378, "width": 348, "height": 92, "points": [[0, 0], [0, 62], [-348, 62], [-348, 92]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "text", "id": "text_120", "x": 1330, "y": 1475, "width": 598, "height": 214, "text": "200 OK\n{\n  \"routes\": [ 3 \u00d7 { distance_mi, duration_s, arrival,\n                    risk: {miles_by_level, exposure, average},\n                    checkpoints[], segments[] } ],\n  \"recommendation\": {\n    \"route_id\": \"a\",\n    \"reason\": \"Least weather exposure: 25.0 vs 50.0 risk-mi on Route C.\"\n  },\n  \"notes\": []\n}", "fontSize": 15, "fontFamily": 5}, {"type": "text", "id": "text_121", "x": 0, "y": 1750, "width": 518, "height": 46, "text": "3 \u00b7 RISK AT ONE CHECKPOINT", "fontSize": 36, "fontFamily": 5}, {"type": "text", "id": "text_122", "x": 0, "y": 1800, "width": 1247, "height": 26, "text": "Each condition gets a level from the thresholds. Load can only raise the wind level. The worst of the three wins.", "fontSize": 20, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_123", "x": 0, "y": 1900, "width": 309, "height": 117, "text": "checkpoint \u00b7 mile 525 \u00b7 ETA Sat 01:30\nweather at that hour (Open-Meteo):\n  wind_mph    40.2\n  rain_in_hr  0.05   (rain + showers)\n  snow_in_hr  0.0\nload_weight_lb  42,000", "fontSize": 15, "fontFamily": 5}, {"type": "line", "id": "line_124", "x": 395, "y": 1965, "width": 1, "height": 1, "points": [[0, 0], [45, 0]], "strokeWidth": 2}, {"type": "line", "id": "line_125", "x": 440, "y": 1910, "width": 1, "height": 1, "points": [[0, 0], [0, 180]], "strokeWidth": 2}, {"type": "arrow", "id": "arrow_126", "x": 440, "y": 1910, "width": 22, "height": 0, "points": [[0, 0], [22, 0]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "arrow", "id": "arrow_127", "x": 440, "y": 2000, "width": 22, "height": 0, "points": [[0, 0], [22, 0]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "arrow", "id": "arrow_128", "x": 440, "y": 2090, "width": 22, "height": 0, "points": [[0, 0], [22, 0]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "text", "id": "text_129", "x": 470, "y": 1898, "width": 125, "height": 22, "text": "wind 40.2 mph", "fontSize": 17, "fontFamily": 5}, {"type": "arrow", "id": "arrow_130", "x": 640, "y": 1910, "width": 100, "height": 0, "points": [[0, 0], [100, 0]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "text", "id": "text_131", "x": 650, "y": 1884, "width": 81, "height": 18, "text": "thresholds", "fontSize": 14, "fontFamily": 5}, {"type": "text", "id": "text_132", "x": 752, "y": 1898, "width": 41, "height": 22, "text": "High", "fontSize": 17, "fontFamily": 5}, {"type": "text", "id": "text_133", "x": 470, "y": 1988, "width": 144, "height": 22, "text": "rain 0.05 in/hr", "fontSize": 17, "fontFamily": 5}, {"type": "arrow", "id": "arrow_134", "x": 640, "y": 2000, "width": 100, "height": 0, "points": [[0, 0], [100, 0]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "text", "id": "text_135", "x": 650, "y": 1974, "width": 81, "height": 18, "text": "thresholds", "fontSize": 14, "fontFamily": 5}, {"type": "text", "id": "text_136", "x": 752, "y": 1988, "width": 32, "height": 22, "text": "Low", "fontSize": 17, "fontFamily": 5}, {"type": "text", "id": "text_137", "x": 470, "y": 2078, "width": 134, "height": 22, "text": "snow 0.0 in/hr", "fontSize": 17, "fontFamily": 5}, {"type": "arrow", "id": "arrow_138", "x": 640, "y": 2090, "width": 100, "height": 0, "points": [[0, 0], [100, 0]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "text", "id": "text_139", "x": 650, "y": 2064, "width": 81, "height": 18, "text": "thresholds", "fontSize": 14, "fontFamily": 5}, {"type": "text", "id": "text_140", "x": 752, "y": 2078, "width": 32, "height": 22, "text": "Low", "fontSize": 17, "fontFamily": 5}, {"type": "arrow", "id": "arrow_141", "x": 800, "y": 1910, "width": 105, "height": 0, "points": [[0, 0], [105, 0]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "rectangle", "id": "rectangle_142", "x": 912, "y": 1865, "width": 22, "height": 90, "strokeWidth": 4, "strokeColor": "#1e1e1e"}, {"type": "line", "id": "line_143", "x": 916, "y": 1901.0, "width": 14, "height": 30, "strokeWidth": 3, "points": [[0, 0], [6, 14], [14, -16]]}, {"type": "text", "id": "text_144", "x": 880, "y": 1960, "width": 86, "height": 19, "text": "load rules", "fontSize": 15, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "arrow", "id": "arrow_145", "x": 940, "y": 1910, "width": 90, "height": 0, "points": [[0, 0], [90, 0]], "endArrowhead": "arrow", "strokeWidth": 2, "strokeColor": "#e03131"}, {"type": "text", "id": "text_146", "x": 1040, "y": 1898, "width": 60, "height": 22, "text": "Severe", "fontSize": 17, "fontFamily": 5, "strokeColor": "#e03131"}, {"type": "text", "id": "text_147", "x": 960, "y": 1845, "width": 188, "height": 18, "text": "> 40,000 lb at 35\u201344 mph", "fontSize": 14, "fontFamily": 5, "strokeColor": "#e03131"}, {"type": "rectangle", "id": "rectangle_148", "x": 1210, "y": 1960, "width": 230, "height": 80, "strokeWidth": 1, "strokeColor": "#000000", "backgroundColor": "#eeeeee"}, {"type": "text", "id": "text_149", "x": 1222, "y": 1968, "width": 162, "height": 20, "text": "worst of the three", "fontSize": 16, "fontFamily": 1}, {"type": "text", "id": "text_150", "x": 1222, "y": 2000, "width": 154, "height": 16, "text": "max(wind, rain, snow)", "fontSize": 13, "fontFamily": 1, "strokeColor": "#495057"}, {"type": "arrow", "id": "arrow_151", "x": 1110, "y": 1912, "width": 95, "height": 68, "points": [[0, 0], [95, 68]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "arrow", "id": "arrow_152", "x": 800, "y": 2000, "width": 405, "height": 0, "points": [[0, 0], [405, 0]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "arrow", "id": "arrow_153", "x": 800, "y": 2090, "width": 405, "height": 68, "points": [[0, 0], [300, 0], [405, -68]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "arrow", "id": "arrow_154", "x": 1445, "y": 2000, "width": 60, "height": 0, "points": [[0, 0], [60, 0]], "endArrowhead": "arrow", "strokeWidth": 2}, {"type": "text", "id": "text_155", "x": 1515, "y": 1935, "width": 243, "height": 117, "text": "level: \"severe\"   (score 3)\nload_raised: true\nreasons:\n  \"Wind 40.2 mph \u2192 High\"\n  \"Load 42,000 lb raises wind\n   risk High \u2192 Severe\" ", "fontSize": 15, "fontFamily": 5}, {"type": "rectangle", "id": "rectangle_156", "x": 0, "y": 2200, "width": 780, "height": 114, "strokeWidth": 1, "strokeColor": "#1e1e1e", "backgroundColor": "#ffffff"}, {"type": "line", "id": "line_157", "x": 0, "y": 2230, "width": 780, "height": 0, "strokeWidth": 1, "points": [[0, 0], [780, 0]]}, {"type": "text", "id": "text_158", "x": 10, "y": 2206, "width": 4, "height": 18, "text": "", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_159", "x": 10, "y": 2236, "width": 70, "height": 19, "text": "wind mph", "fontSize": 15, "fontFamily": 5}, {"type": "text", "id": "text_160", "x": 10, "y": 2262, "width": 86, "height": 19, "text": "rain in/hr", "fontSize": 15, "fontFamily": 5}, {"type": "text", "id": "text_161", "x": 10, "y": 2288, "width": 86, "height": 19, "text": "snow in/hr", "fontSize": 15, "fontFamily": 5}, {"type": "line", "id": "line_162", "x": 120, "y": 2200, "width": 0, "height": 114, "strokeWidth": 1, "points": [[0, 0], [0, 114]]}, {"type": "text", "id": "text_163", "x": 130, "y": 2206, "width": 27, "height": 18, "text": "Low", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_164", "x": 130, "y": 2236, "width": 37, "height": 19, "text": "< 25", "fontSize": 15, "fontFamily": 5}, {"type": "text", "id": "text_165", "x": 130, "y": 2262, "width": 53, "height": 19, "text": "< 0.10", "fontSize": 15, "fontFamily": 5}, {"type": "text", "id": "text_166", "x": 130, "y": 2288, "width": 45, "height": 19, "text": "< 0.5", "fontSize": 15, "fontFamily": 5}, {"type": "line", "id": "line_167", "x": 220, "y": 2200, "width": 0, "height": 114, "strokeWidth": 1, "points": [[0, 0], [0, 114]]}, {"type": "text", "id": "text_168", "x": 230, "y": 2206, "width": 65, "height": 18, "text": "Moderate", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_169", "x": 230, "y": 2236, "width": 78, "height": 19, "text": "25 \u2013 < 35", "fontSize": 15, "fontFamily": 5}, {"type": "text", "id": "text_170", "x": 230, "y": 2262, "width": 111, "height": 19, "text": "0.10 \u2013 < 0.25", "fontSize": 15, "fontFamily": 5}, {"type": "text", "id": "text_171", "x": 230, "y": 2288, "width": 94, "height": 19, "text": "0.5 \u2013 < 1.0", "fontSize": 15, "fontFamily": 5}, {"type": "line", "id": "line_172", "x": 370, "y": 2200, "width": 0, "height": 114, "strokeWidth": 1, "points": [[0, 0], [0, 114]]}, {"type": "text", "id": "text_173", "x": 380, "y": 2206, "width": 34, "height": 18, "text": "High", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_174", "x": 380, "y": 2236, "width": 78, "height": 19, "text": "35 \u2013 < 45", "fontSize": 15, "fontFamily": 5}, {"type": "text", "id": "text_175", "x": 380, "y": 2262, "width": 111, "height": 19, "text": "0.25 \u2013 < 0.50", "fontSize": 15, "fontFamily": 5}, {"type": "text", "id": "text_176", "x": 380, "y": 2288, "width": 94, "height": 19, "text": "1.0 \u2013 < 2.0", "fontSize": 15, "fontFamily": 5}, {"type": "line", "id": "line_177", "x": 520, "y": 2200, "width": 0, "height": 114, "strokeWidth": 1, "points": [[0, 0], [0, 114]]}, {"type": "text", "id": "text_178", "x": 530, "y": 2206, "width": 50, "height": 18, "text": "Severe", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_179", "x": 530, "y": 2236, "width": 78, "height": 19, "text": "45 \u2013 < 55", "fontSize": 15, "fontFamily": 5}, {"type": "text", "id": "text_180", "x": 530, "y": 2262, "width": 94, "height": 19, "text": "0.50 \u2013 1.00", "fontSize": 15, "fontFamily": 5}, {"type": "text", "id": "text_181", "x": 530, "y": 2288, "width": 78, "height": 19, "text": "2.0 \u2013 3.0", "fontSize": 15, "fontFamily": 5}, {"type": "line", "id": "line_182", "x": 660, "y": 2200, "width": 0, "height": 114, "strokeWidth": 1, "points": [[0, 0], [0, 114]]}, {"type": "text", "id": "text_183", "x": 670, "y": 2206, "width": 73, "height": 18, "text": "No Travel", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_184", "x": 670, "y": 2236, "width": 37, "height": 19, "text": "\u2265 55", "fontSize": 15, "fontFamily": 5}, {"type": "text", "id": "text_185", "x": 670, "y": 2262, "width": 53, "height": 19, "text": "> 1.00", "fontSize": 15, "fontFamily": 5}, {"type": "text", "id": "text_186", "x": 670, "y": 2288, "width": 45, "height": 19, "text": "> 3.0", "fontSize": 15, "fontFamily": 5}, {"type": "text", "id": "text_187", "x": 860, "y": 2200, "width": 373, "height": 83, "text": "load rules (wind only, can only raise it):\n  \u2265 55 mph, any load          \u2192 No Travel\n  45\u201354 mph and > 30,000 lb   \u2192 No Travel\n  35\u201344 mph and > 40,000 lb   \u2192 Severe", "fontSize": 16, "fontFamily": 5}, {"type": "text", "id": "text_188", "x": 860, "y": 2310, "width": 622, "height": 39, "text": "the brief's ranges share edges, so each includes its lower bound:\nrain exactly 0.25 \u2192 High \u00b7 No Travel keeps the strict >: rain 1.00 \u2192 Severe", "fontSize": 15, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_189", "x": 860, "y": 2370, "width": 474, "height": 19, "text": "wind = sustained 10 m wind; gusts are shown, never scored", "fontSize": 15, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_190", "x": 0, "y": 2470, "width": 419, "height": 46, "text": "4 \u00b7 PICKING THE ROUTE", "fontSize": 36, "fontFamily": 5}, {"type": "text", "id": "text_191", "x": 0, "y": 2520, "width": 1346, "height": 26, "text": "A strict order: a route only reaches the next test if it ties on every test above. The reason names the test that decided.", "fontSize": 20, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "line", "id": "line_192", "x": 27, "y": 2627, "width": 1, "height": 1, "points": [[0, 0], [0, 360]], "strokeWidth": 2}, {"type": "ellipse", "id": "ellipse_193", "x": 20, "y": 2620, "width": 14, "height": 14, "strokeWidth": 1, "strokeColor": "#1e1e1e", "backgroundColor": "#1e1e1e"}, {"type": "text", "id": "text_194", "x": 50, "y": 2614, "width": 251, "height": 23, "text": "1  fewest No Travel miles", "fontSize": 18, "fontFamily": 5}, {"type": "text", "id": "text_195", "x": 72, "y": 2640, "width": 404, "height": 18, "text": "before Severe: a No Travel stretch is strictly worse", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_196", "x": 400, "y": 2660, "width": 42, "height": 18, "text": "tie \u2193", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "ellipse", "id": "ellipse_197", "x": 20, "y": 2710, "width": 14, "height": 14, "strokeWidth": 1, "strokeColor": "#1e1e1e", "backgroundColor": "#1e1e1e"}, {"type": "text", "id": "text_198", "x": 50, "y": 2704, "width": 221, "height": 23, "text": "2  fewest Severe miles", "fontSize": 18, "fontFamily": 5}, {"type": "text", "id": "text_199", "x": 400, "y": 2750, "width": 42, "height": 18, "text": "tie \u2193", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "ellipse", "id": "ellipse_200", "x": 20, "y": 2800, "width": 14, "height": 14, "strokeWidth": 1, "strokeColor": "#1e1e1e", "backgroundColor": "#1e1e1e"}, {"type": "text", "id": "text_201", "x": 50, "y": 2794, "width": 202, "height": 23, "text": "3  fewest High miles", "fontSize": 18, "fontFamily": 5}, {"type": "text", "id": "text_202", "x": 400, "y": 2840, "width": 42, "height": 18, "text": "tie \u2193", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "ellipse", "id": "ellipse_203", "x": 20, "y": 2890, "width": 14, "height": 14, "strokeWidth": 1, "strokeColor": "#1e1e1e", "backgroundColor": "#1e1e1e"}, {"type": "text", "id": "text_204", "x": 50, "y": 2884, "width": 251, "height": 23, "text": "4  least weather exposure", "fontSize": 18, "fontFamily": 5}, {"type": "text", "id": "text_205", "x": 72, "y": 2910, "width": 404, "height": 18, "text": "risk-miles = each mile \u00d7 level (Mod 1 \u2026 No Travel 4)", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_206", "x": 400, "y": 2930, "width": 42, "height": 18, "text": "tie \u2193", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "ellipse", "id": "ellipse_207", "x": 20, "y": 2980, "width": 14, "height": 14, "strokeWidth": 1, "strokeColor": "#1e1e1e", "backgroundColor": "#1e1e1e"}, {"type": "text", "id": "text_208", "x": 50, "y": 2974, "width": 221, "height": 23, "text": "5  shortest drive time", "fontSize": 18, "fontFamily": 5}, {"type": "text", "id": "text_209", "x": 72, "y": 3000, "width": 196, "height": 18, "text": "after the truck speed cap", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_210", "x": 20, "y": 3090, "width": 548, "height": 19, "text": "\"Least weather exposure: 25.0 risk-mi vs 50.0 risk-mi on Route C.\"", "fontSize": 15, "fontFamily": 5}, {"type": "text", "id": "text_211", "x": 20, "y": 3120, "width": 504, "height": 18, "text": "miles and risk-miles compare at 0.1, so float noise never decides", "fontSize": 14, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_212", "x": 700, "y": 2610, "width": 379, "height": 28, "text": "WHICH MILES A CHECKPOINT COVERS", "fontSize": 22, "fontFamily": 5}, {"type": "text", "id": "text_213", "x": 700, "y": 2642, "width": 449, "height": 19, "text": "one Severe sample at mile 100, checkpoints every 50 mi", "fontSize": 15, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_214", "x": 700, "y": 2680, "width": 256, "height": 22, "text": "worse of its two neighbours", "fontSize": 17, "fontFamily": 5, "strokeColor": "#e03131"}, {"type": "line", "id": "line_215", "x": 710, "y": 2720, "width": 1, "height": 1, "points": [[0, 0], [640.0, 0]], "strokeWidth": 2}, {"type": "line", "id": "line_216", "x": 870.0, "y": 2720, "width": 1, "height": 1, "points": [[0.0, 0], [320.0, 0]], "strokeWidth": 6, "strokeColor": "#e03131"}, {"type": "ellipse", "id": "ellipse_217", "x": 703.0, "y": 2713, "width": 14, "height": 14, "strokeWidth": 1, "strokeColor": "#1e1e1e", "backgroundColor": "#1e1e1e"}, {"type": "text", "id": "text_218", "x": 698.0, "y": 2734, "width": 11, "height": 16, "text": "0", "fontSize": 13, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "ellipse", "id": "ellipse_219", "x": 863.0, "y": 2713, "width": 14, "height": 14, "strokeWidth": 1, "strokeColor": "#1e1e1e", "backgroundColor": "#1e1e1e"}, {"type": "text", "id": "text_220", "x": 858.0, "y": 2734, "width": 18, "height": 16, "text": "50", "fontSize": 13, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "ellipse", "id": "ellipse_221", "x": 1023.0, "y": 2713, "width": 14, "height": 14, "strokeWidth": 1, "strokeColor": "#e03131", "backgroundColor": "#e03131"}, {"type": "text", "id": "text_222", "x": 1018.0, "y": 2734, "width": 25, "height": 16, "text": "100", "fontSize": 13, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "ellipse", "id": "ellipse_223", "x": 1183.0, "y": 2713, "width": 14, "height": 14, "strokeWidth": 1, "strokeColor": "#1e1e1e", "backgroundColor": "#1e1e1e"}, {"type": "text", "id": "text_224", "x": 1178.0, "y": 2734, "width": 25, "height": 16, "text": "150", "fontSize": 13, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "ellipse", "id": "ellipse_225", "x": 1343.0, "y": 2713, "width": 14, "height": 14, "strokeWidth": 1, "strokeColor": "#1e1e1e", "backgroundColor": "#1e1e1e"}, {"type": "text", "id": "text_226", "x": 1338.0, "y": 2734, "width": 25, "height": 16, "text": "200", "fontSize": 13, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_227", "x": 1380.0, "y": 2692, "width": 292, "height": 58, "text": "one sample counts for 100 Severe mi\n(20 at 10 mi spacing): the pick can\nflip when only the interval changes", "fontSize": 15, "fontFamily": 5, "strokeColor": "#e03131"}, {"type": "line", "id": "line_228", "x": 950, "y": 2674, "width": 20, "height": 20, "strokeWidth": 4, "strokeColor": "#e03131", "points": [[0, 0], [20, 20]]}, {"type": "line", "id": "line_229", "x": 970, "y": 2674, "width": 20, "height": 20, "strokeWidth": 4, "strokeColor": "#e03131", "points": [[0, 0], [-20, 20]]}, {"type": "text", "id": "text_230", "x": 700, "y": 2830, "width": 237, "height": 22, "text": "halfway to each neighbour", "fontSize": 17, "fontFamily": 5, "strokeColor": "#2f9e44"}, {"type": "line", "id": "line_231", "x": 710, "y": 2870, "width": 1, "height": 1, "points": [[0, 0], [640.0, 0]], "strokeWidth": 2}, {"type": "line", "id": "line_232", "x": 950.0, "y": 2870, "width": 1, "height": 1, "points": [[0.0, 0], [160.0, 0]], "strokeWidth": 6, "strokeCol