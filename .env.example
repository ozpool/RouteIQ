# RouteIQ environment — copy to `.env` (git-ignored) and adjust.
#   cp .env.example .env
#
# One file for the whole repo:
#   - the Django backend reads it through config/env.py (typed + validated, fails fast)
#   - Vite reads only the VITE_* keys (envDir is the repo root)
#   - docker compose passes it to the container
# In production, set these as real environment variables on the host instead of a file.
# No key below is required for local development; all providers are free and keyless.

# ---------------------------------------------------------------- runtime
# development | test | production   (production refuses unsafe values at startup)
APP_ENV=development
DEBUG=true
# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
LOG_LEVEL=INFO

# ---------------------------------------------------------------- http / security
# Comma-separated lists.
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=
# Production only. Set false when no proxy in front of the app terminates TLS.
SECURE_SSL_REDIRECT=true

# ---------------------------------------------------------------- cache
# Empty = in-process memory cache. Set a Redis URL to share the cache across workers.
# CACHE_URL=redis://localhost:6379/0
CACHE_URL=
WEATHER_CACHE_TTL_SECONDS=1800
GEOCODE_CACHE_TTL_SECONDS=86400

# ---------------------------------------------------------------- providers
OSRM_BASE_URL=https://router.project-osrm.org
OPEN_METEO_BASE_URL=https://api.open-meteo.com
# Optional. The free tier allows ~600 location lookups/minute and 5,000/hour; a trip uses at most
# ~400 (250 checkpoint + 150 heatmap lookups), and repeats are served from the cache.
# With a paid key, also set OPEN_METEO_BASE_URL=https://customer-api.open-meteo.com
OPEN_METEO_API_KEY=
PHOTON_BASE_URL=https://photon.komoot.io
HTTP_TIMEOUT_SECONDS=12
# Public OSM services ask for an identifying User-Agent; add a contact URL or email.
HTTP_USER_AGENT=RouteIQ/1.0 (weather-aware truck routing)

# ---------------------------------------------------------------- routing model
# OSRM's car profile is faster than a loaded truck; segment speeds are capped at this.
TRUCK_MAX_SPEED_MPH=65

# ---------------------------------------------------------------- frontend (public, baked into the bundle)
# Empty = same origin (Vite dev proxy locally, Django serves the SPA in production).
VITE_API_BASE_URL=
VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
